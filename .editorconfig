root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Makefile は TAB 必須
[Makefile]
indent_style = tab

# Markdown は trailing-whitespace に意味がある (改行) のでオフ
[*.md]
trim_trailing_whitespace = false

[*.go]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4
