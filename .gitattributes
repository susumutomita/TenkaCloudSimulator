# 改行コードを LF に正規化し、Windows でチェックアウトしても LF を保つ。
# CRLF が混ざると Biome / textlint / shell スクリプトが期待外れの挙動になるため、
# 開発者環境に依存しないよう Git レベルで固定する。
* text=auto eol=lf

# Lockfile は GitHub の "Linguist" 統計から外し、PR diff の "Load diff" を初期非表示にする。
bun.lock          text linguist-generated=true linguist-language=JSON
bun.lockb         binary linguist-generated=true
package-lock.json text linguist-generated=true
pnpm-lock.yaml    text linguist-generated=true
yarn.lock         text linguist-generated=true

# シェル / Makefile は LF 強制 (一部 Windows ツールが CRLF にしてしまうため)
*.sh        text eol=lf
Makefile    text eol=lf
*.mk        text eol=lf

# Windows でのバイナリ判定が必要なファイル
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.woff      binary
*.woff2     binary

# Preserve the verified upstream bundle byte for byte; review via pinned provenance.
internal/server/apidocs/scalar.js -text -diff linguist-vendored

internal/server/apidocs/scalar.css -text -diff linguist-vendored

tools/scalar/bundle-inputs.json linguist-generated
tools/scalar/bundle-digests.json linguist-generated
# Preserve original mixed-line-ending third-party notice bytes in this bundle.
third_party/CONSOLE-NOTICES.txt -text -whitespace
internal/legal/assets/CONSOLE-NOTICES.txt -text -whitespace

# Generated Cloudscape inputs/assets are reviewed through source and provenance.
internal/server/web/app.js -text -diff linguist-vendored
internal/server/web/app.css -text -diff linguist-vendored
tools/console/bundle-inputs.json linguist-generated
tools/console/bundle-digests.json linguist-generated

# Original CPython/WASI rights bytes and fixed embedded runtime artifacts.
third_party/PYTHON-NOTICES.txt -text -whitespace
internal/legal/assets/PYTHON-NOTICES.txt -text -whitespace
internal/workload/python/assets/* binary linguist-vendored
third_party/python.json linguist-generated
