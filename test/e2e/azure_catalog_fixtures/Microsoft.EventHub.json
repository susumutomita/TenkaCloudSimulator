{
 "namespace": "Microsoft.EventHub",
 "client": "eventhub",
 "steps": [
  {
   "call": "namespaces.begin_create_or_update",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events",
    "parameters": {
     "location": "eastus",
     "sku": {
      "name": "Standard"
     }
    }
   },
   "expect": {
    "provisioning_state": "Succeeded",
    "sku.tier": "Standard"
   }
  },
  {
   "call": "namespaces.get",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events"
   },
   "expect": {
    "status": "Active"
   }
  },
  {
   "call": "namespaces.update",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events",
    "parameters": {
     "tags": {
      "team": "a"
     }
    }
   },
   "expect": {
    "tags.team": "a"
   }
  },
  {
   "call": "namespaces.list_by_resource_group",
   "args": {
    "resource_group_name": "${rg}"
   },
   "expect": {
    "#count": 1
   }
  },
  {
   "call": "namespaces.list",
   "expect": {
    "#count": 1
   }
  },
  {
   "call": "event_hubs.create_or_update",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events",
    "event_hub_name": "orders",
    "parameters": {
     "properties": {
      "partitionCount": 2,
      "messageRetentionInDays": 1
     }
    }
   },
   "expect": {
    "partition_ids": [
     "0",
     "1"
    ]
   }
  },
  {
   "call": "event_hubs.get",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events",
    "event_hub_name": "orders"
   },
   "expect": {
    "name": "orders"
   }
  },
  {
   "call": "event_hubs.list_by_namespace",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events",
    "top": 1
   },
   "expect": {
    "#count": 1
   }
  },
  {
   "call": "event_hubs.get",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "missing-space",
    "event_hub_name": "orders"
   },
   "error": "ParentResourceNotFound",
   "status": 404
  }
 ],
 "probe": {
  "call": "namespaces.list"
 },
 "unbound": {
  "call": "namespaces.list_keys",
  "args": {
   "resource_group_name": "${rg}",
   "namespace_name": "fixture-events",
   "authorization_rule_name": "RootManageSharedAccessKey"
  }
 },
 "isolation": [
  {
   "call": "namespaces.list",
   "expect": {
    "#count": 0
   }
  }
 ],
 "after_restart": [
  {
   "call": "event_hubs.get",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events",
    "event_hub_name": "orders"
   },
   "expect": {
    "name": "orders"
   }
  }
 ],
 "cleanup": [
  {
   "call": "event_hubs.delete",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events",
    "event_hub_name": "orders"
   }
  },
  {
   "call": "namespaces.begin_delete",
   "args": {
    "resource_group_name": "${rg}",
    "namespace_name": "fixture-events"
   }
  },
  {
   "call": "namespaces.list",
   "expect": {
    "#count": 0
   }
  }
 ]
}
