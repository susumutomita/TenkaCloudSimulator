  {"op": "create_channel", "args": {"ChannelName": "fixture-channel", "PlaybackMode": "LINEAR", "Tier": "STANDARD", "Outputs": [{"ManifestName": "main", "SourceGroup": "hls", "HlsPlaylistSettings": {"ManifestWindowSeconds": 60}}], "FillerSlate": {"SourceLocationName": "fixture-origin", "VodSourceName": "fixture-movie"}, "Tags": {"team": "a"}}, "save": {"channel_arn": "Arn"}, "expect": {"ChannelState": "STOPPED"}},
