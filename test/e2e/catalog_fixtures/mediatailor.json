  {"op": "untag_resource", "args": {"ResourceArn": "${channel_arn}", "TagKeys": ["k"]}},
  {"op": "list_tags_for_resource", "args": {"ResourceArn": "${channel_arn}"}, "expect": {"Tags": {"team": "a"}}},
  {"op": "create_channel", "args": {"ChannelName": "fixture-linear", "PlaybackMode": "LINEAR", "Outputs": [{"ManifestName": "main", "SourceGroup": "hls"}]}, "error": "ValidationException", "status": 400},
  {"op": "create_source_location", "args": {"SourceLocationName": "fixture-bad", "HttpConfiguration": {"BaseUrl": "origin.example.com"}}, "error": "ValidationException", "status": 400},
