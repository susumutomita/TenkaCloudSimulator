{
 "client": "deadline",
 "inject_host_prefix": false,
 "steps": [
  {"op": "create_farm", "args": {"displayName": "fixture studio", "description": "fixture farm", "tags": {"team": "a"}}, "save": {"farm": "farmId"}},
  {"op": "get_farm", "args": {"farmId": "${farm}"}, "expect": {"displayName": "fixture studio"}},
  {"op": "update_farm", "args": {"farmId": "${farm}", "displayName": "fixture studio2"}},
  {"op": "list_farms", "args": {}, "expect": {"farms#count": 1, "farms[0].displayName": "fixture studio2"}},
  {"op": "create_queue", "args": {"farmId": "${farm}", "displayName": "fixture queue", "tags": {"k": "v"}}, "save": {"queue": "queueId"}},
  {"op": "get_queue", "args": {"farmId": "${farm}", "queueId": "${queue}"}, "expect": {"status": "IDLE", "defaultBudgetAction": "NONE"}},
  {"op": "update_queue", "args": {"farmId": "${farm}", "queueId": "${queue}", "defaultBudgetAction": "STOP_SCHEDULING_AND_CANCEL_TASKS"}},
  {"op": "list_queues", "args": {"farmId": "${farm}", "status": "IDLE"}, "expect": {"queues#count": 1}},
  {"op": "create_fleet", "args": {"farmId": "${farm}", "displayName": "fixture fleet", "roleArn": "arn:aws:iam::000000000000:role/FixtureFleet", "maxWorkerCount": 5, "configuration": {"customerManaged": {"mode": "NO_SCALING", "workerCapabilities": {"vCpuCount": {"min": 1}, "memoryMiB": {"min": 1024}, "osFamily": "LINUX", "cpuArchitectureType": "x86_64"}}}}, "save": {"fleet": "fleetId"}},
  {"op": "get_fleet", "args": {"farmId": "${farm}", "fleetId": "${fleet}"}, "expect": {"status": "ACTIVE", "workerCount": 0}},
  {"op": "update_fleet", "args": {"farmId": "${farm}", "fleetId": "${fleet}", "maxWorkerCount": 8, "minWorkerCount": 2}},
  {"op": "list_fleets", "args": {"farmId": "${farm}", "status": "ACTIVE"}, "expect": {"fleets#count": 1}},
  {"op": "create_storage_profile", "args": {"farmId": "${farm}", "displayName": "fixture profile", "osFamily": "LINUX"}, "save": {"profile": "storageProfileId"}},
  {"op": "get_storage_profile", "args": {"farmId": "${farm}", "storageProfileId": "${profile}"}, "expect": {"osFamily": "LINUX"}},
  {"op": "update_storage_profile", "args": {"farmId": "${farm}", "storageProfileId": "${profile}", "osFamily": "MACOS"}},
  {"op": "list_storage_profiles", "args": {"farmId": "${farm}"}, "expect": {"storageProfiles#count": 1}},
  {"op": "create_limit", "args": {"farmId": "${farm}", "displayName": "fixture limit", "amountRequirementName": "amount.license", "maxCount": 4}, "save": {"limit": "limitId"}},
  {"op": "get_limit", "args": {"farmId": "${farm}", "limitId": "${limit}"}, "expect": {"maxCount": 4, "currentCount": 0}},
  {"op": "update_limit", "args": {"farmId": "${farm}", "limitId": "${limit}", "maxCount": -1}},
  {"op": "list_limits", "args": {"farmId": "${farm}"}, "expect": {"limits#count": 1}},
  {"op": "create_budget", "args": {"farmId": "${farm}", "displayName": "fixture budget", "approximateDollarLimit": 100.5, "usageTrackingResource": {"queueId": "${queue}"}, "actions": [{"type": "STOP_SCHEDULING_AND_COMPLETE_TASKS", "thresholdPercentage": 90}], "schedule": {"fixed": {"startTime": 1700000000, "endTime": 1800000000}}}, "save": {"budget": "budgetId"}},
  {"op": "get_budget", "args": {"farmId": "${farm}", "budgetId": "${budget}"}, "expect": {"status": "ACTIVE"}},
  {"op": "update_budget", "args": {"farmId": "${farm}", "budgetId": "${budget}", "status": "INACTIVE"}},
  {"op": "list_budgets", "args": {"farmId": "${farm}", "status": "INACTIVE"}, "expect": {"budgets#count": 1}},
  {"op": "tag_resource", "args": {"resourceArn": "arn:aws:deadline:us-east-1:000000000000:farm/${farm}", "tags": {"extra": "1"}}},
  {"op": "list_tags_for_resource", "args": {"resourceArn": "arn:aws:deadline:us-east-1:000000000000:farm/${farm}"}, "expect": {"tags": {"team": "a", "extra": "1"}}},
  {"op": "untag_resource", "args": {"resourceArn": "arn:aws:deadline:us-east-1:000000000000:farm/${farm}", "tagKeys": ["extra"]}},
  {"op": "create_limit", "args": {"farmId": "${farm}", "displayName": "zero", "amountRequirementName": "amount.x", "maxCount": 0}, "error": "ValidationException"},
  {"op": "delete_farm", "args": {"farmId": "${farm}"}, "error": "ValidationException"},
  {"op": "get_farm", "args": {"farmId": "farm-00000000000000000000000000000000"}, "error": "ResourceNotFoundException", "status": 404}
 ],
 "isolation": [
  {"op": "list_farms", "args": {}, "expect": {"farms#count": 0}}
 ],
 "after_restart": [
  {"op": "get_queue", "args": {"farmId": "${farm}", "queueId": "${queue}"}, "expect": {"defaultBudgetAction": "STOP_SCHEDULING_AND_CANCEL_TASKS"}}
 ],
 "cleanup": [
  {"op": "delete_budget", "args": {"farmId": "${farm}", "budgetId": "${budget}"}},
  {"op": "delete_limit", "args": {"farmId": "${farm}", "limitId": "${limit}"}},
  {"op": "delete_storage_profile", "args": {"farmId": "${farm}", "storageProfileId": "${profile}"}},
  {"op": "delete_fleet", "args": {"farmId": "${farm}", "fleetId": "${fleet}"}},
  {"op": "delete_queue", "args": {"farmId": "${farm}", "queueId": "${queue}"}},
  {"op": "delete_farm", "args": {"farmId": "${farm}"}},
  {"op": "list_farms", "args": {}, "expect": {"farms#count": 0}}
 ]
}
