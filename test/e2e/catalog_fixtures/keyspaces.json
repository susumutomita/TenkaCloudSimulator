{
 "client": "keyspaces",
 "steps": [
  {"op": "create_keyspace", "args": {"keyspaceName": "fixture_shop", "tags": [{"key": "team", "value": "a"}]}, "save": {"ks_arn": "resourceArn"}},
  {"op": "get_keyspace", "args": {"keyspaceName": "fixture_shop"}, "expect": {"resourceArn": "${ks_arn}", "replicationStrategy": "SINGLE_REGION"}},
  {"op": "list_keyspaces", "args": {}, "expect": {"keyspaces#count": 1, "keyspaces[0].keyspaceName": "fixture_shop"}},
  {"op": "create_table", "args": {"keyspaceName": "fixture_shop", "tableName": "orders", "schemaDefinition": {"allColumns": [{"name": "id", "type": "uuid"}, {"name": "title", "type": "text"}, {"name": "tags", "type": "set<text>"}], "partitionKeys": [{"name": "id"}], "clusteringKeys": [{"name": "title", "orderBy": "ASC"}]}, "comment": {"message": "fixture orders"}, "tags": [{"key": "stage", "value": "dev"}]}, "save": {"table_arn": "resourceArn"}},
  {"op": "get_table", "args": {"keyspaceName": "fixture_shop", "tableName": "orders"}, "expect": {"resourceArn": "${table_arn}", "status": "ACTIVE", "capacitySpecification.throughputMode": "PAY_PER_REQUEST", "encryptionSpecification.type": "AWS_OWNED_KMS_KEY", "schemaDefinition.partitionKeys[0].name": "id"}},
  {"op": "list_tables", "args": {"keyspaceName": "fixture_shop"}, "expect": {"tables#count": 1, "tables[0].tableName": "orders"}},
  {"op": "update_table", "args": {"keyspaceName": "fixture_shop", "tableName": "orders", "capacitySpecification": {"throughputMode": "PROVISIONED", "readCapacityUnits": 5, "writeCapacityUnits": 5}, "pointInTimeRecovery": {"status": "ENABLED"}}, "expect": {"resourceArn": "${table_arn}"}},
  {"op": "create_type", "args": {"keyspaceName": "fixture_shop", "typeName": "Address", "fieldDefinitions": [{"name": "street", "type": "text"}, {"name": "zip", "type": "int"}]}, "expect": {"typeName": "address", "keyspaceArn": "${ks_arn}"}},
  {"op": "get_type", "args": {"keyspaceName": "fixture_shop", "typeName": "address"}, "expect": {"status": "ACTIVE", "fieldDefinitions#count": 2}},
  {"op": "list_types", "args": {"keyspaceName": "fixture_shop"}, "expect": {"types#count": 1, "types[0]": "address"}},
  {"op": "tag_resource", "args": {"resourceArn": "${table_arn}", "tags": [{"key": "owner", "value": "me"}]}},
  {"op": "list_tags_for_resource", "args": {"resourceArn": "${table_arn}"}, "expect": {"tags#count": 2}},
  {"op": "get_keyspace", "args": {"keyspaceName": "nothing"}, "error": "ResourceNotFoundException", "status": 400},
  {"op": "create_keyspace", "args": {"keyspaceName": "system"}, "error": "ConflictException", "status": 400},
  {"op": "create_table", "args": {"keyspaceName": "fixture_shop", "tableName": "nokey", "schemaDefinition": {"allColumns": [{"name": "id", "type": "uuid"}], "partitionKeys": [{"name": "missing"}]}}, "error": "ValidationException", "status": 400},
  {"op": "update_keyspace", "args": {"keyspaceName": "fixture_shop", "replicationSpecification": {"replicationStrategy": "MULTI_REGION", "regionList": ["us-east-1", "us-west-2"]}}, "error": "UnknownOperationException", "status": 501},
  {"op": "untag_resource", "args": {"resourceArn": "${table_arn}", "tags": [{"key": "owner", "value": "me"}]}, "error": "UnknownOperationException", "status": 501}
 ],
 "isolation": [
  {"op": "list_keyspaces", "args": {}, "expect": {"keyspaces#count": 0}}
 ],
 "after_restart": [
  {"op": "get_table", "args": {"keyspaceName": "fixture_shop", "tableName": "orders"}, "expect": {"capacitySpecification.readCapacityUnits": 5, "pointInTimeRecovery.status": "ENABLED"}}
 ],
 "cleanup": [
  {"op": "delete_type", "args": {"keyspaceName": "fixture_shop", "typeName": "address"}, "expect": {"typeName": "address"}},
  {"op": "delete_table", "args": {"keyspaceName": "fixture_shop", "tableName": "orders"}},
  {"op": "delete_keyspace", "args": {"keyspaceName": "fixture_shop"}},
  {"op": "list_keyspaces", "args": {}, "expect": {"keyspaces#count": 0}}
 ]
}
