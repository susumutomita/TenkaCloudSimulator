{
 "client": "directconnect",
 "steps": [
  {"op": "create_direct_connect_gateway", "args": {"directConnectGatewayName": "fixture-gateway", "amazonSideAsn": 64600, "tags": [{"key": "team", "value": "a"}]}, "save": {"gateway": "directConnectGateway.directConnectGatewayId"}, "expect": {"directConnectGateway.directConnectGatewayState": "pending", "directConnectGateway.amazonSideAsn": 64600, "directConnectGateway.ownerAccount": "000000000000"}},
  {"op": "describe_direct_connect_gateways", "args": {}, "expect": {"directConnectGateways#count": 1}},
  {"op": "describe_direct_connect_gateways", "args": {"directConnectGatewayId": "${gateway}"}, "expect": {"directConnectGateways[0].directConnectGatewayName": "fixture-gateway", "directConnectGateways[0].tags[0].key": "team"}},
  {"op": "update_direct_connect_gateway", "args": {"directConnectGatewayId": "${gateway}", "newDirectConnectGatewayName": "fixture-backbone"}, "expect": {"directConnectGateway.directConnectGatewayName": "fixture-backbone"}},
  {"op": "tag_resource", "args": {"resourceArn": "arn:aws:directconnect::000000000000:dx-gateway/${gateway}", "tags": [{"key": "env", "value": "lab"}]}},
  {"op": "untag_resource", "args": {"resourceArn": "arn:aws:directconnect::000000000000:dx-gateway/${gateway}", "tagKeys": ["team"]}},
  {"op": "describe_direct_connect_gateways", "args": {"directConnectGatewayId": "${gateway}"}, "expect": {"directConnectGateways[0].tags#count": 1, "directConnectGateways[0].tags[0].key": "env"}},
  {"op": "create_direct_connect_gateway", "args": {"directConnectGatewayName": "fixture-public-asn", "amazonSideAsn": 100}, "error": "DirectConnectClientException"},
  {"op": "tag_resource", "args": {"resourceArn": "arn:aws:directconnect::000000000000:dx-gateway/missing", "tags": [{"key": "a", "value": "b"}]}, "error": "DirectConnectClientException"},
  {"op": "describe_tags", "args": {"resourceArns": ["arn:aws:directconnect::000000000000:dx-gateway/${gateway}"]}, "error": "UnknownOperationException", "status": 501}
 ],
 "isolation": [
  {"op": "describe_direct_connect_gateways", "args": {}, "expect": {"directConnectGateways#count": 0}}
 ],
 "after_restart": [
  {"op": "describe_direct_connect_gateways", "args": {"directConnectGatewayId": "${gateway}"}, "expect": {"directConnectGateways[0].directConnectGatewayName": "fixture-backbone"}}
 ],
 "cleanup": [
  {"op": "delete_direct_connect_gateway", "args": {"directConnectGatewayId": "${gateway}"}, "expect": {"directConnectGateway.directConnectGatewayState": "deleted"}},
  {"op": "describe_direct_connect_gateways", "args": {}, "expect": {"directConnectGateways#count": 0}}
 ]
}
