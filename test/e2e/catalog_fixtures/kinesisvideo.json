{
 "client": "kinesisvideo",
 "denied_status": 401,
 "steps": [
  {"op": "create_stream", "args": {"StreamName": "fixture-camera", "DeviceName": "cam-1", "MediaType": "video/h264", "DataRetentionInHours": 24, "Tags": {"team": "a"}}, "save": {"stream": "StreamARN"}},
  {"op": "describe_stream", "args": {"StreamName": "fixture-camera"}, "save": {"version": "StreamInfo.Version"}, "expect": {"StreamInfo.StreamARN": "${stream}", "StreamInfo.Status": "CREATING", "StreamInfo.DataRetentionInHours": 24, "StreamInfo.DeviceName": "cam-1"}},
  {"op": "describe_stream", "args": {"StreamARN": "${stream}"}, "expect": {"StreamInfo.StreamName": "fixture-camera"}},
  {"op": "list_streams", "args": {}, "expect": {"StreamInfoList#count": 1}},
  {"op": "update_stream", "args": {"StreamName": "fixture-camera", "CurrentVersion": "stale", "MediaType": "video/h265"}, "error": "VersionMismatchException", "status": 400},
  {"op": "update_stream", "args": {"StreamName": "fixture-camera", "CurrentVersion": "${version}", "MediaType": "video/h265"}},
  {"op": "describe_stream", "args": {"StreamName": "fixture-camera"}, "save": {"version2": "StreamInfo.Version"}, "expect": {"StreamInfo.MediaType": "video/h265"}},
  {"op": "update_data_retention", "args": {"StreamName": "fixture-camera", "CurrentVersion": "${version2}", "Operation": "DECREASE_DATA_RETENTION", "DataRetentionChangeInHours": 4}},
  {"op": "describe_stream", "args": {"StreamName": "fixture-camera"}, "expect": {"StreamInfo.DataRetentionInHours": 20}},
  {"op": "tag_resource", "args": {"ResourceARN": "${stream}", "Tags": [{"Key": "k", "Value": "v"}]}},
  {"op": "untag_resource", "args": {"ResourceARN": "${stream}", "TagKeyList": ["k"]}},
  {"op": "list_tags_for_resource", "args": {"ResourceARN": "${stream}"}, "expect": {"Tags": {"team": "a"}}},
  {"op": "create_stream", "args": {"StreamName": "fixture-camera"}, "error": "ResourceInUseException", "status": 400},
  {"op": "create_signaling_channel", "args": {"ChannelName": "fixture-channel", "Tags": [{"Key": "team", "Value": "a"}]}, "save": {"channel": "ChannelARN"}},
  {"op": "describe_signaling_channel", "args": {"ChannelName": "fixture-channel"}, "save": {"channelVersion": "ChannelInfo.Version"}, "expect": {"ChannelInfo.ChannelARN": "${channel}", "ChannelInfo.ChannelStatus": "CREATING", "ChannelInfo.SingleMasterConfiguration.MessageTtlSeconds": 60}},
  {"op": "list_signaling_channels", "args": {}, "expect": {"ChannelInfoList#count": 1}},
  {"op": "update_signaling_channel", "args": {"ChannelARN": "${channel}", "CurrentVersion": "${channelVersion}", "SingleMasterConfiguration": {"MessageTtlSeconds": 90}}},
  {"op": "describe_signaling_channel", "args": {"ChannelARN": "${channel}"}, "expect": {"ChannelInfo.SingleMasterConfiguration.MessageTtlSeconds": 90}},
  {"op": "update_signaling_channel", "args": {"ChannelARN": "${channel}", "CurrentVersion": "${channelVersion}", "SingleMasterConfiguration": {"MessageTtlSeconds": 30}}, "error": "VersionMismatchException", "status": 400},
  {"op": "get_data_endpoint", "args": {"StreamName": "fixture-camera", "APIName": "PUT_MEDIA"}, "error": "UnknownOperationException", "status": 501},
  {"op": "describe_stream", "args": {"StreamName": "missing-camera"}, "error": "ResourceNotFoundException", "status": 404}
 ],
 "isolation": [
  {"op": "list_streams", "args": {}, "expect": {"StreamInfoList#count": 0}},
  {"op": "list_signaling_channels", "args": {}, "expect": {"ChannelInfoList#count": 0}}
 ],
 "after_restart": [
  {"op": "describe_stream", "args": {"StreamARN": "${stream}"}, "expect": {"StreamInfo.DataRetentionInHours": 20}}
 ],
 "cleanup": [
  {"op": "delete_stream", "args": {"StreamARN": "${stream}"}},
  {"op": "delete_signaling_channel", "args": {"ChannelARN": "${channel}"}},
  {"op": "list_streams", "args": {}, "expect": {"StreamInfoList#count": 0}}
 ]
}
