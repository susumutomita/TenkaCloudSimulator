  {"op": "describe_migration_task", "args": {"ProgressUpdateStream": "fixture-tool", "MigrationTaskName": "web-1"}, "expect": {"MigrationTask.MigrationTaskName": "web-1", "MigrationTask.ProgressUpdateStream": "fixture-tool"}},
  {"op": "notify_migration_task_state", "args": {"ProgressUpdateStream": "fixture-tool", "MigrationTaskName": "web-1", "UpdateDateTime": 1790000000, "NextUpdateSeconds": 60, "Task": {"Status": "IN_PROGRESS", "ProgressPercent": 40, "StatusDetail": "copying"}}},
  {"op": "describe_migration_task", "args": {"ProgressUpdateStream": "fixture-tool", "MigrationTaskName": "web-1"}, "expect": {"MigrationTask.Task.Status": "IN_PROGRESS", "MigrationTask.Task.StatusDetail": "copying"}},
  {"op": "create_progress_update_stream", "args": {"ProgressUpdateStreamName": "fixture-tool"}, "error": "InvalidInputException"},
