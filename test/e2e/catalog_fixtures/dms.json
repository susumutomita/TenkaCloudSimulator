{
 "client": "dms",
 "steps": [
  {"op": "create_replication_subnet_group", "args": {"ReplicationSubnetGroupIdentifier": "Fixture-Group", "ReplicationSubnetGroupDescription": "fixture", "SubnetIds": ["subnet-aaaa1111", "subnet-bbbb2222"]}, "expect": {"ReplicationSubnetGroup.ReplicationSubnetGroupIdentifier": "fixture-group", "ReplicationSubnetGroup.SubnetGroupStatus": "Complete"}},
  {"op": "modify_replication_subnet_group", "args": {"ReplicationSubnetGroupIdentifier": "fixture-group", "ReplicationSubnetGroupDescription": "fixture2", "SubnetIds": ["subnet-aaaa1111", "subnet-bbbb2222", "subnet-cccc3333"]}},
  {"op": "describe_replication_subnet_groups", "args": {}, "expect": {"ReplicationSubnetGroups#count": 1, "ReplicationSubnetGroups[0].ReplicationSubnetGroupDescription": "fixture2"}},
  {"op": "create_event_subscription", "args": {"SubscriptionName": "fixture-sub", "SnsTopicArn": "arn:aws:sns:us-east-1:000000000000:fixture-events", "SourceType": "replication-task", "EventCategories": ["failure"]}, "expect": {"EventSubscription.Status": "active"}},
  {"op": "modify_event_subscription", "args": {"SubscriptionName": "fixture-sub", "Enabled": false}},
