 ],
 "cleanup": [
  {"op": "delete_migration_project", "args": {"MigrationProjectIdentifier": "fixture-project"}},
  {"op": "delete_instance_profile", "args": {"InstanceProfileIdentifier": "fixture-profile"}},
  {"op": "delete_data_provider", "args": {"DataProviderIdentifier": "fixture-source"}},
  {"op": "delete_event_subscription", "args": {"SubscriptionName": "fixture-sub"}},
  {"op": "delete_replication_subnet_group", "args": {"ReplicationSubnetGroupIdentifier": "fixture-group"}},
  {"op": "describe_data_providers", "args": {}, "expect": {"DataProviders#count": 0}}
 ]
