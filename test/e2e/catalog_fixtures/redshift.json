{
 "client": "redshift",
 "denied": "AccessDenied",
 "steps": [
  {"op": "create_cluster_parameter_group", "args": {"ParameterGroupName": "Fixture-Params", "ParameterGroupFamily": "redshift-1.0", "Description": "fixture parameter group", "Tags": [{"Key": "team", "Value": "a"}]}, "expect": {"ClusterParameterGroup.ParameterGroupName": "fixture-params", "ClusterParameterGroup.Tags[0].Key": "team"}},
  {"op": "describe_cluster_parameter_groups", "args": {"ParameterGroupName": "fixture-params"}, "expect": {"ParameterGroups#count": 1, "ParameterGroups[0].ParameterGroupFamily": "redshift-1.0"}},
  {"op": "create_cluster_subnet_group", "args": {"ClusterSubnetGroupName": "Fixture-Subnets", "Description": "fixture subnets", "SubnetIds": ["subnet-0a1b2c3d", "subnet-4e5f6a7b"]}, "expect": {"ClusterSubnetGroup.ClusterSubnetGroupName": "fixture-subnets", "ClusterSubnetGroup.Subnets#count": 2}},
  {"op": "describe_cluster_subnet_groups", "args": {"ClusterSubnetGroupName": "fixture-subnets"}, "expect": {"ClusterSubnetGroups#count": 1}},
  {"op": "modify_cluster_subnet_group", "args": {"ClusterSubnetGroupName": "fixture-subnets", "Description": "three subnets", "SubnetIds": ["subnet-0a1b2c3d", "subnet-4e5f6a7b", "subnet-0123456789abcdef0"]}, "expect": {"ClusterSubnetGroup.Description": "three subnets", "ClusterSubnetGroup.Subnets#count": 3}},
  {"op": "create_tags", "args": {"ResourceName": "arn:aws:redshift:us-east-1:000000000000:subnetgroup:fixture-subnets", "Tags": [{"Key": "stage", "Value": "dev"}, {"Key": "drop", "Value": "me"}]}},
  {"op": "delete_tags", "args": {"ResourceName": "arn:aws:redshift:us-east-1:000000000000:subnetgroup:fixture-subnets", "TagKeys": ["drop"]}},
  {"op": "describe_cluster_subnet_groups", "args": {}, "expect": {"ClusterSubnetGroups[0].Tags#count": 1, "ClusterSubnetGroups[0].Tags[0].Key": "stage"}},
  {"op": "create_cluster_subnet_group", "args": {"ClusterSubnetGroupName": "default", "Description": "reserved", "SubnetIds": ["subnet-0a1b2c3d"]}, "error": "InvalidParameterValue", "status": 400},
  {"op": "create_cluster_parameter_group", "args": {"ParameterGroupName": "fixture-params", "ParameterGroupFamily": "redshift-1.0", "Description": "again"}, "error": "ClusterParameterGroupAlreadyExists", "status": 400},
  {"op": "describe_cluster_parameter_groups", "args": {"ParameterGroupName": "missing-params"}, "error": "ClusterParameterGroupNotFound", "status": 404},
  {"op": "create_tags", "args": {"ResourceName": "arn:aws:redshift:us-east-1:000000000000:cluster:missing", "Tags": [{"Key": "a", "Value": "b"}]}, "error": "ResourceNotFoundFault", "status": 404},
  {"op": "create_cluster", "args": {"ClusterIdentifier": "fixture-cluster", "NodeType": "ra3.xlplus", "MasterUsername": "admin"}, "error": "UnknownOperationException", "status": 501}
 ],
 "isolation": [
  {"op": "describe_cluster_parameter_groups", "args": {}, "expect": {"ParameterGroups#count": 0}},
  {"op": "describe_cluster_subnet_groups", "args": {}, "expect": {"ClusterSubnetGroups#count": 0}}
 ],
 "after_restart": [
  {"op": "describe_cluster_subnet_groups", "args": {"ClusterSubnetGroupName": "fixture-subnets"}, "expect": {"ClusterSubnetGroups[0].Description": "three subnets", "ClusterSubnetGroups[0].Subnets#count": 3, "ClusterSubnetGroups[0].Tags[0].Value": "dev"}},
  {"op": "describe_cluster_parameter_groups", "args": {"ParameterGroupName": "fixture-params"}, "expect": {"ParameterGroups[0].Tags[0].Value": "a"}}
 ],
 "cleanup": [
  {"op": "delete_cluster_subnet_group", "args": {"ClusterSubnetGroupName": "fixture-subnets"}},
  {"op": "delete_cluster_parameter_group", "args": {"ParameterGroupName": "fixture-params"}},
  {"op": "describe_cluster_parameter_groups", "args": {}, "expect": {"ParameterGroups#count": 0}},
  {"op": "describe_cluster_subnet_groups", "args": {}, "expect": {"ClusterSubnetGroups#count": 0}}
 ]
