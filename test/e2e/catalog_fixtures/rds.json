  {"op": "describe_db_instances", "args": {"DBInstanceIdentifier": "fixture-db"}, "expect": {"DBInstances[0].AllocatedStorage": 50, "DBInstances[0].DBInstanceStatus": "creating"}},
  {"op": "list_tags_for_resource", "args": {"ResourceName": "${dbarn}"}, "expect": {"TagList#count": 2}},
  {"op": "describe_db_clusters", "args": {}, "expect": {"DBClusters#count": 1, "DBClusters[0].BackupRetentionPeriod": 5}}
