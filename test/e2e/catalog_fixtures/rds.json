  {"op": "describe_db_instances", "args": {"DBInstanceIdentifier": "fixture-db"}, "expect": {"DBInstances#count": 1, "DBInstances[0].DBInstanceStatus": "creating", "DBInstances[0].TagList[0].Key": "team"}},
