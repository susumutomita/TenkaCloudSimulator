{
 "client": "docdb",
 "model": "rds",
 "denied": "AccessDenied",
 "steps": [
  {"op": "create_db_subnet_group", "args": {"DBSubnetGroupName": "Fixture-doc-Subnets", "DBSubnetGroupDescription": "fixture", "SubnetIds": ["subnet-0a1b2c3d", "subnet-4e5f6a7b"], "Tags": [{"Key": "team", "Value": "a"}]}, "save": {"subnets": "DBSubnetGroup.DBSubnetGroupArn"}, "expect": {"DBSubnetGroup.DBSubnetGroupName": "fixture-doc-subnets", "DBSubnetGroup.Subnets#count": 2}},
  {"op": "describe_db_subnet_groups", "args": {"DBSubnetGroupName": "fixture-doc-subnets"}, "expect": {"DBSubnetGroups#count": 1, "DBSubnetGroups[0].DBSubnetGroupDescription": "fixture"}},
  {"op": "modify_db_subnet_group", "args": {"DBSubnetGroupName": "fixture-doc-subnets", "DBSubnetGroupDescription": "three", "SubnetIds": ["subnet-0a1b2c3d", "subnet-4e5f6a7b", "subnet-0123456789abcdef0"]}, "expect": {"DBSubnetGroup.Subnets#count": 3, "DBSubnetGroup.DBSubnetGroupDescription": "three"}},
  {"op": "create_db_cluster_parameter_group", "args": {"DBClusterParameterGroupName": "Fixture-doc-Cluster", "DBParameterGroupFamily": "docdb5.0", "Description": "fixture"}, "save": {"cluster": "DBClusterParameterGroup.DBClusterParameterGroupArn"}, "expect": {"DBClusterParameterGroup.DBClusterParameterGroupName": "fixture-doc-cluster", "DBClusterParameterGroup.DBParameterGroupFamily": "docdb5.0", "DBClusterParameterGroup.DBClusterParameterGroupArn": "arn:aws:rds:us-east-1:000000000000:cluster-pg:fixture-doc-cluster"}},
  {"op": "describe_db_cluster_parameter_groups", "args": {"DBClusterParameterGroupName": "fixture-doc-cluster"}, "expect": {"DBClusterParameterGroups#count": 1}},
  {"op": "add_tags_to_resource", "args": {"ResourceName": "${cluster}", "Tags": [{"Key": "stage", "Value": "dev"}, {"Key": "drop", "Value": "me"}]}},
  {"op": "remove_tags_from_resource", "args": {"ResourceName": "${cluster}", "TagKeys": ["drop"]}},
  {"op": "list_tags_for_resource", "args": {"ResourceName": "${cluster}"}, "expect": {"TagList": [{"Key": "stage", "Value": "dev"}]}},
  {"op": "list_tags_for_resource", "args": {"ResourceName": "${subnets}"}, "expect": {"TagList[0].Key": "team"}},
  {"op": "create_db_subnet_group", "args": {"DBSubnetGroupName": "fixture-doc-subnets", "DBSubnetGroupDescription": "again", "SubnetIds": ["subnet-0a1b2c3d", "subnet-4e5f6a7b"]}, "error": "DBSubnetGroupAlreadyExists", "status": 400},
  {"op": "describe_db_subnet_groups", "args": {"DBSubnetGroupName": "fixture-missing"}, "error": "DBSubnetGroupNotFoundFault", "status": 404},
  {"op": "describe_db_cluster_parameter_groups", "args": {"DBClusterParameterGroupName": "fixture-missing"}, "error": "DBParameterGroupNotFound", "status": 404},
  {"op": "describe_db_subnet_groups", "args": {"Filters": [{"Name": "engine", "Values": ["doc"]}]}, "error": "InvalidParameterValue", "status": 400},
  {"op": "create_db_cluster", "args": {"DBClusterIdentifier": "fixture-doc", "Engine": "docdb"}, "error": "UnknownOperationException", "status": 501}
 ],
 "isolation": [
  {"op": "describe_db_subnet_groups", "args": {}, "expect": {"DBSubnetGroups#count": 0}},
  {"op": "describe_db_cluster_parameter_groups", "args": {}, "expect": {"DBClusterParameterGroups#count": 0}}
 ],
 "after_restart": [
  {"op": "describe_db_subnet_groups", "args": {"DBSubnetGroupName": "fixture-doc-subnets"}, "expect": {"DBSubnetGroups[0].Subnets#count": 3}},
  {"op": "list_tags_for_resource", "args": {"ResourceName": "${cluster}"}, "expect": {"TagList": [{"Key": "stage", "Value": "dev"}]}}
 ],
 "cleanup": [
  {"op": "delete_db_subnet_group", "args": {"DBSubnetGroupName": "fixture-doc-subnets"}},
  {"op": "delete_db_cluster_parameter_group", "args": {"DBClusterParameterGroupName": "fixture-doc-cluster"}},
  {"op": "describe_db_subnet_groups", "args": {"DBSubnetGroupName": "fixture-doc-subnets"}, "error": "DBSubnetGroupNotFoundFault", "status": 404},
  {"op": "describe_db_cluster_parameter_groups", "args": {"DBClusterParameterGroupName": "fixture-doc-cluster"}, "error": "DBParameterGroupNotFound", "status": 404}
 ]
}
