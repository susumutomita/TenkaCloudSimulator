{
 "client": "grafana",
 "steps": [
  {"op": "create_workspace", "args": {"accountAccessType": "CURRENT_ACCOUNT", "authenticationProviders": ["AWS_SSO", "SAML"], "permissionType": "CUSTOMER_MANAGED", "workspaceRoleArn": "arn:aws:iam::000000000000:role/fixture-grafana", "workspaceName": "fixture-ops", "workspaceDescription": "fixture dashboards", "workspaceDataSources": ["CLOUDWATCH"], "workspaceNotificationDestinations": ["SNS"], "tags": {"team": "a"}, "vpcConfiguration": {"subnetIds": ["subnet-0a1b2c3d", "subnet-4e5f6a7b"], "securityGroupIds": ["sg-0a1b2c3d"]}, "networkAccessControl": {"prefixListIds": ["pl-1a2b3c4d"], "vpceIds": ["vpce-0a1b2c3d"]}}, "save": {"ws": "workspace.id"}, "expect": {"workspace.status": "ACTIVE", "workspace.name": "fixture-ops", "workspace.authentication.samlConfigurationStatus": "NOT_CONFIGURED", "workspace.tags": {"team": "a"}}},
  {"op": "describe_workspace", "args": {"workspaceId": "${ws}"}, "expect": {"workspace.id": "${ws}", "workspace.description": "fixture dashboards", "workspace.grafanaVersion": "10.4", "workspace.vpcConfiguration.securityGroupIds[0]": "sg-0a1b2c3d"}},
  {"op": "list_workspaces", "args": {}, "expect": {"workspaces#count": 1, "workspaces[0].id": "${ws}"}},
  {"op": "update_workspace", "args": {"workspaceId": "${ws}", "workspaceName": "fixture-ops-2", "removeVpcConfiguration": true}, "expect": {"workspace.name": "fixture-ops-2"}},
  {"op": "tag_resource", "args": {"resourceArn": "arn:aws:grafana:us-east-1:000000000000:/workspaces/${ws}", "tags": {"stage": "dev"}}},
  {"op": "untag_resource", "args": {"resourceArn": "arn:aws:grafana:us-east-1:000000000000:/workspaces/${ws}", "tagKeys": ["stage"]}},
  {"op": "list_tags_for_resource", "args": {"resourceArn": "arn:aws:grafana:us-east-1:000000000000:/workspaces/${ws}"}, "expect": {"tags": {"team": "a"}}},
  {"op": "describe_workspace", "args": {"workspaceId": "g-0123456789"}, "error": "ResourceNotFoundException", "status": 404},
  {"op": "create_workspace", "args": {"accountAccessType": "CURRENT_ACCOUNT", "authenticationProviders": ["AWS_SSO"], "permissionType": "SERVICE_MANAGED"}, "error": "ValidationException", "status": 400},
  {"op": "create_workspace_api_key", "args": {"workspaceId": "${ws}", "keyName": "fixture", "keyRole": "VIEWER", "secondsToLive": 60}, "error": "UnknownOperationException", "status": 501}
 ],
 "isolation": [
  {"op": "list_workspaces", "args": {}, "expect": {"workspaces#count": 0}}
 ],
 "after_restart": [
  {"op": "describe_workspace", "args": {"workspaceId": "${ws}"}, "expect": {"workspace.name": "fixture-ops-2", "workspace.status": "ACTIVE"}}
 ],
 "cleanup": [
  {"op": "delete_workspace", "args": {"workspaceId": "${ws}"}, "expect": {"workspace.status": "DELETING"}},
  {"op": "list_workspaces", "args": {}, "expect": {"workspaces#count": 0}}
 ]
}
