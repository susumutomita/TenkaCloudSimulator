{
 "api": "looker.v1",
 "steps": [
  {"call": "projects.locations.instances.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "instanceId": "fixture"}, "body": {"platformEdition": "LOOKER_CORE_STANDARD", "oauthConfig": {"clientId": "client-id"}}, "save": {"op": "name", "instance": "response.name"}, "expect": {"done": true}},
  {"call": "projects.locations.operations.get", "args": {"name": "${op}"}, "expect": {"response.state": "ACTIVE"}},
  {"call": "projects.locations.operations.list", "args": {"name": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"operations#count": 1}},
  {"call": "projects.locations.instances.get", "args": {"name": "${instance}"}, "expect": {"platformEdition": "LOOKER_CORE_STANDARD"}},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "showDeleted": true}, "expect": {"instances#count": 1}},
  {"call": "projects.locations.instances.patch", "args": {"name": "${instance}", "updateMask": "adminSettings"}, "body": {"adminSettings": {"allowedEmailDomains": ["example.com"]}}},
  {"call": "projects.locations.instances.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "instanceId": "secret"}, "body": {"oauthConfig": {"clientId": "c", "clientSecret": "not-stored"}}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "projects.locations.instances.restart", "args": {"name": "${instance}", "body": {}}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.locations.instances.get", "args": {"name": "projects/tenkacloud-local/locations/us-central1/instances/missing"}, "error": "NOT_FOUND", "status": 404},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/other-project/locations/us-central1"}, "error": "PERMISSION_DENIED", "status": 403}
 ],
 "isolation": [
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"instances#count": 0}}
 ],
 "after_restart": [
  {"call": "projects.locations.instances.get", "args": {"name": "${instance}"}, "expect": {"adminSettings.allowedEmailDomains[0]": "example.com"}}
 ],
 "cleanup": [
  {"call": "projects.locations.instances.delete", "args": {"name": "${instance}"}},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"instances#count": 0}}
 ]
}
