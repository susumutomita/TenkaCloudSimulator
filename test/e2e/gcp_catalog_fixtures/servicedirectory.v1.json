  {"call": "projects.locations.namespaces.services.endpoints.patch", "args": {"name": "${r2}", "updateMask": "port"}, "body": {"port": 8443}},
  {"call": "projects.locations.namespaces.services.endpoints.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1/namespaces/fixture/services/web", "endpointId": "bad"}, "error": "INVALID_ARGUMENT", "status": 400, "body": {"address": "10.0.0.10:443"}},
  {"call": "projects.locations.namespaces.services.resolve", "args": {"name": "projects/tenkacloud-local/locations/us-central1/namespaces/fixture/services/web", "body": {}}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.locations.namespaces.get", "args": {"name": "projects/tenkacloud-local/locations/us-central1/namespaces/missing"}, "error": "NOT_FOUND", "status": 404},
  {"call": "projects.locations.namespaces.list", "args": {"parent": "projects/other-project/locations/us-central1"}, "error": "PERMISSION_DENIED", "status": 403}
 ],
