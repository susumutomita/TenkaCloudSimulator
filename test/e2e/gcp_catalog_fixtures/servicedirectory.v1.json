  {"call": "projects.locations.namespaces.services.patch", "args": {"name": "${r1}", "updateMask": "annotations"}, "body": {"annotations": {"owner": "b"}}},
  {"call": "projects.locations.namespaces.services.endpoints.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1/namespaces/fixture/services/web", "endpointId": "primary"}, "body": {"address": "10.0.0.10", "port": 443, "network": "projects/100000000001/locations/global/networks/default"}, "save": {"r2": "name"}},
  {"call": "projects.locations.namespaces.services.endpoints.get", "args": {"name": "${r2}"}},
