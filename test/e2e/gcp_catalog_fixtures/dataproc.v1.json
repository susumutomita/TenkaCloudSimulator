  {"call": "projects.locations.sessionTemplates.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "body": {"name": "projects/tenkacloud-local/locations/us-central1/sessionTemplates/fixture", "runtimeConfig": {"version": "2.2"}, "jupyterSession": {"kernel": "PYTHON"}}, "save": {"template": "name"}},
