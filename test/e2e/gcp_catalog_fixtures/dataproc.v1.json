  {"call": "projects.locations.autoscalingPolicies.update", "args": {"name": "${policy}"}, "body": {"id": "fixture", "workerConfig": {"maxInstances": 20}, "basicAlgorithm": {"yarnConfig": {"gracefulDecommissionTimeout": "600s", "scaleUpFactor": 1.0, "scaleDownFactor": 1.0}}}, "expect": {"workerConfig.maxInstances": 20}},
  {"call": "projects.locations.autoscalingPolicies.update", "args": {"name": "${policy}"}, "body": {"id": "renamed", "workerConfig": {"maxInstances": 20}}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "projects.locations.sessionTemplates.patch", "args": {"name": "${template}"}, "body": {"name": "${template}", "description": "Notebook", "runtimeConfig": {"version": "2.2"}, "jupyterSession": {"kernel": "PYTHON"}}, "expect": {"description": "Notebook"}},
  {"call": "projects.locations.workflowTemplates.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "body": {"id": "wf", "placement": {"managedCluster": {"clusterName": "c", "config": {}}}, "jobs": []}}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.locations.batches.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "batchId": "job", "body": {"sparkBatch": {"mainClass": "Main"}}}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.regions.autoscalingPolicies.list", "args": {"parent": "projects/tenkacloud-local/regions/us-central1"}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.locations.autoscalingPolicies.get", "args": {"name": "projects/tenkacloud-local/locations/us-central1/autoscalingPolicies/missing"}, "error": "NOT_FOUND", "status": 404},
  {"call": "projects.locations.autoscalingPolicies.list", "args": {"parent": "projects/other-project/locations/us-central1"}, "error": "PERMISSION_DENIED", "status": 403}
 ],
