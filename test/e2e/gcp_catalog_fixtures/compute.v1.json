{
 "api": "compute.v1",
 "steps": [
  {"call": "networks.insert", "args": {"project": "tenkacloud-local"}, "body": {"name": "fixture-vpc", "autoCreateSubnetworks": false, "description": "Fixture"}, "save": {"op": "name"}, "expect": {"status": "DONE", "operationType": "insert", "kind": "compute#operation"}},
  {"call": "globalOperations.get", "args": {"project": "tenkacloud-local", "operation": "${op}"}, "expect": {"status": "DONE"}},
  {"call": "globalOperations.wait", "args": {"project": "tenkacloud-local", "operation": "${op}"}, "expect": {"targetLink": "https://www.googleapis.com/compute/v1/projects/tenkacloud-local/global/networks/fixture-vpc"}},
  {"call": "globalOperations.list", "args": {"project": "tenkacloud-local"}, "expect": {"items#count": 1}},
  {"call": "networks.get", "args": {"project": "tenkacloud-local", "network": "fixture-vpc"}, "save": {"vpc": "selfLink"}, "expect": {"kind": "compute#network", "mtu": 1460}},
  {"call": "networks.list", "args": {"project": "tenkacloud-local"}, "expect": {"items#count": 1}},
  {"call": "networks.patch", "args": {"project": "tenkacloud-local", "network": "fixture-vpc"}, "body": {"routingConfig": {"routingMode": "GLOBAL"}}, "expect": {"operationType": "patch"}},
  {"call": "subnetworks.insert", "args": {"project": "tenkacloud-local", "region": "us-central1"}, "body": {"name": "app", "network": "${vpc}", "ipCidrRange": "10.0.0.0/24"}, "save": {"sop": "name"}, "expect": {"region": "https://www.googleapis.com/compute/v1/projects/tenkacloud-local/regions/us-central1"}},
  {"call": "regionOperations.get", "args": {"project": "tenkacloud-local", "region": "us-central1", "operation": "${sop}"}, "expect": {"status": "DONE"}},
  {"call": "regionOperations.wait", "args": {"project": "tenkacloud-local", "region": "us-central1", "operation": "${sop}"}, "expect": {"status": "DONE"}},
  {"call": "regionOperations.list", "args": {"project": "tenkacloud-local", "region": "us-central1"}, "expect": {"items#count": 1}},
  {"call": "subnetworks.get", "args": {"project": "tenkacloud-local", "region": "us-central1", "subnetwork": "app"}, "save": {"fp": "fingerprint"}, "expect": {"network": "${vpc}", "state": "READY"}},
  {"call": "subnetworks.list", "args": {"project": "tenkacloud-local", "region": "us-central1"}, "expect": {"items#count": 1}},
  {"call": "subnetworks.patch", "args": {"project": "tenkacloud-local", "region": "us-central1", "subnetwork": "app"}, "body": {"fingerprint": "${fp}", "privateIpGoogleAccess": true}},
  {"call": "subnetworks.expandIpCidrRange", "args": {"project": "tenkacloud-local", "region": "us-central1", "subnetwork": "app"}, "body": {"ipCidrRange": "10.0.0.0/22"}, "expect": {"operationType": "expandIpCidrRange"}},
  {"call": "subnetworks.setPrivateIpGoogleAccess", "args": {"project": "tenkacloud-local", "region": "us-central1", "subnetwork": "app"}, "body": {"privateIpGoogleAccess": false}},
  {"call": "subnetworks.insert", "args": {"project": "tenkacloud-local", "region": "asia-northeast1"}, "body": {"name": "overlap", "network": "${vpc}", "ipCidrRange": "10.0.2.0/24"}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "firewalls.insert", "args": {"project": "tenkacloud-local"}, "body": {"name": "allow-ssh", "network": "global/networks/fixture-vpc", "allowed": [{"IPProtocol": "tcp", "ports": ["22"]}], "sourceRanges": ["35.235.240.0/20"], "targetTags": ["ssh"]}},
  {"call": "firewalls.get", "args": {"project": "tenkacloud-local", "firewall": "allow-ssh"}, "expect": {"direction": "INGRESS", "priority": 1000, "network": "${vpc}"}},
  {"call": "firewalls.list", "args": {"project": "tenkacloud-local"}, "expect": {"items#count": 1}},
  {"call": "firewalls.patch", "args": {"project": "tenkacloud-local", "firewall": "allow-ssh"}, "body": {"disabled": true}},
  {"call": "routes.insert", "args": {"project": "tenkacloud-local"}, "body": {"name": "egress", "destRange": "0.0.0.0/0", "priority": 1000, "network": "global/networks/fixture-vpc", "nextHopGateway": "global/gateways/default-internet-gateway"}},
  {"call": "routes.get", "args": {"project": "tenkacloud-local", "route": "egress"}, "expect": {"routeType": "STATIC"}},
  {"call": "routes.list", "args": {"project": "tenkacloud-local"}, "expect": {"items#count": 1}},
  {"call": "disks.insert", "args": {"project": "tenkacloud-local", "zone": "us-central1-a"}, "body": {"name": "data", "sizeGb": "20", "type": "zones/us-central1-a/diskTypes/pd-balanced"}, "save": {"dop": "name"}, "expect": {"zone": "https://www.googleapis.com/compute/v1/projects/tenkacloud-local/zones/us-central1-a"}},
  {"call": "zoneOperations.get", "args": {"project": "tenkacloud-local", "zone": "us-central1-a", "operation": "${dop}"}, "expect": {"status": "DONE"}},
  {"call": "zoneOperations.wait", "args": {"project": "tenkacloud-local", "zone": "us-central1-a", "operation": "${dop}"}, "expect": {"status": "DONE"}},
  {"call": "zoneOperations.list", "args": {"project": "tenkacloud-local", "zone": "us-central1-a"}, "expect": {"items#count": 1}},
  {"call": "disks.get", "args": {"project": "tenkacloud-local", "zone": "us-central1-a", "disk": "data"}, "save": {"lf": "labelFingerprint"}, "expect": {"status": "READY", "sizeGb": "20"}},
  {"call": "disks.list", "args": {"project": "tenkacloud-local", "zone": "us-central1-a"}, "expect": {"items#count": 1}},
  {"call": "disks.setLabels", "args": {"project": "tenkacloud-local", "zone": "us-central1-a", "resource": "data"}, "body": {"labels": {"team": "a"}, "labelFingerprint": "${lf}"}},
  {"call": "disks.resize", "args": {"project": "tenkacloud-local", "zone": "us-central1-a", "disk": "data"}, "body": {"sizeGb": "40"}},
  {"call": "disks.insert", "args": {"project": "tenkacloud-local", "zone": "us-central1-a"}, "body": {"name": "secret", "diskEncryptionKey": {"rawKey": "c2VjcmV0"}}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "snapshots.insert", "args": {"project": "tenkacloud-local"}, "body": {"name": "snap", "sourceDisk": "zones/us-central1-a/disks/data"}},
  {"call": "snapshots.get", "args": {"project": "tenkacloud-local", "snapshot": "snap"}, "save": {"slf": "labelFingerprint"}, "expect": {"status": "READY", "storageBytes": "0"}},
  {"call": "snapshots.list", "args": {"project": "tenkacloud-local"}, "expect": {"items#count": 1}},
  {"call": "snapshots.setLabels", "args": {"project": "tenkacloud-local", "resource": "snap"}, "body": {"labels": {"k": "v"}, "labelFingerprint": "${slf}"}},
  {"call": "instanceTemplates.insert", "args": {"project": "tenkacloud-local"}, "body": {"name": "web", "properties": {"machineType": "e2-small", "networkInterfaces": [{"subnetwork": "regions/us-central1/subnetworks/app"}]}}},
  {"call": "instanceTemplates.get", "args": {"project": "tenkacloud-local", "instanceTemplate": "web"}, "expect": {"properties.machineType": "e2-small"}},
  {"call": "instanceTemplates.list", "args": {"project": "tenkacloud-local"}, "expect": {"items#count": 1}},
  {"call": "networks.delete", "args": {"project": "tenkacloud-local", "network": "fixture-vpc"}, "error": "FAILED_PRECONDITION", "status": 400},
  {"call": "instances.insert", "args": {"project": "tenkacloud-local", "zone": "us-central1-a"}, "body": {"name": "vm", "machineType": "zones/us-central1-a/machineTypes/e2-small"}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "networks.get", "args": {"project": "tenkacloud-local", "network": "missing"}, "error": "NOT_FOUND", "status": 404},
  {"call": "networks.list", "args": {"project": "other-project"}, "error": "PERMISSION_DENIED", "status": 403}
 ],
 "isolation": [
  {"call": "networks.list", "args": {"project": "tenkacloud-local"}, "expect": {"items#count": 0}},
  {"call": "disks.list", "args": {"project": "tenkacloud-local", "zone": "us-central1-a"}, "expect": {"items#count": 0}}
 ],
 "after_restart": [
  {"call": "networks.get", "args": {"project": "tenkacloud-local", "network": "fixture-vpc"}, "expect": {"routingConfig.routingMode": "GLOBAL"}},
  {"call": "disks.get", "args": {"project": "tenkacloud-local", "zone": "us-central1-a", "disk": "data"}, "expect": {"sizeGb": "40", "labels.team": "a"}}
 ],
 "cleanup": [
  {"call": "instanceTemplates.delete", "args": {"project": "tenkacloud-local", "instanceTemplate": "web"}},
  {"call": "snapshots.delete", "args": {"project": "tenkacloud-local", "snapshot": "snap"}},
  {"call": "disks.delete", "args": {"project": "tenkacloud-local", "zone": "us-central1-a", "disk": "data"}},
  {"call": "routes.delete", "args": {"project": "tenkacloud-local", "route": "egress"}},
  {"call": "firewalls.delete", "args": {"project": "tenkacloud-local", "firewall": "allow-ssh"}},
  {"call": "subnetworks.delete", "args": {"project": "tenkacloud-local", "region": "us-central1", "subnetwork": "app"}},
  {"call": "networks.delete", "args": {"project": "tenkacloud-local", "network": "fixture-vpc"}, "expect": {"operationType": "delete"}},
  {"call": "networks.list", "args": {"project": "tenkacloud-local"}, "expect": {"items#count": 0}},
  {"call": "disks.list", "args": {"project": "tenkacloud-local", "zone": "us-central1-a"}, "expect": {"items#count": 0}}
 ]
}
