{
 "api": "redis.v1",
 "steps": [
  {"call": "projects.locations.instances.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "instanceId": "fixture"}, "body": {"memorySizeGb": 1, "tier": "BASIC", "authEnabled": true, "labels": {"team": "a"}}, "save": {"op": "name", "instance": "response.name"}, "expect": {"done": true}},
  {"call": "projects.locations.operations.get", "args": {"name": "${op}"}, "expect": {"response.state": "READY"}},
  {"call": "projects.locations.operations.list", "args": {"name": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"operations#count": 1}},
  {"call": "projects.locations.instances.get", "args": {"name": "${instance}"}, "expect": {"memorySizeGb": 1, "authEnabled": true}},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"instances#count": 1}},
  {"call": "projects.locations.instances.patch", "args": {"name": "${instance}", "updateMask": "memorySizeGb,displayName"}, "body": {"memorySizeGb": 2, "displayName": "Fixture"}},
  {"call": "projects.locations.instances.getAuthString", "args": {"name": "${instance}"}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.locations.clusters.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "clusterId": "shards"}, "body": {"shardCount": 3, "replicaCount": 1, "deletionProtectionEnabled": true}, "save": {"cluster": "response.name"}, "expect": {"response.state": "ACTIVE"}},
  {"call": "projects.locations.clusters.get", "args": {"name": "${cluster}"}, "expect": {"shardCount": 3}},
  {"call": "projects.locations.clusters.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"clusters#count": 1}},
  {"call": "projects.locations.clusters.patch", "args": {"name": "${cluster}", "updateMask": "replicaCount"}, "body": {"replicaCount": 2}},
  {"call": "projects.locations.clusters.delete", "args": {"name": "${cluster}"}, "error": "FAILED_PRECONDITION", "status": 400},
  {"call": "projects.locations.clusters.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "clusterId": "restored"}, "body": {"gcsSource": {"uris": ["gs://bucket/backup.rdb"]}}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "projects.locations.instances.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "instanceId": "sizeless"}, "body": {"tier": "BASIC"}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/other-project/locations/us-central1"}, "error": "PERMISSION_DENIED", "status": 403}
 ],
 "isolation": [
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"instances#count": 0}}
 ],
 "after_restart": [
  {"call": "projects.locations.instances.get", "args": {"name": "${instance}"}, "expect": {"memorySizeGb": 2, "displayName": "Fixture"}}
 ],
 "cleanup": [
  {"call": "projects.locations.clusters.patch", "args": {"name": "${cluster}", "updateMask": "deletionProtectionEnabled"}, "body": {"deletionProtectionEnabled": false}},
  {"call": "projects.locations.clusters.delete", "args": {"name": "${cluster}"}},
  {"call": "projects.locations.instances.delete", "args": {"name": "${instance}"}},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"instances#count": 0}},
  {"call": "projects.locations.clusters.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"clusters#count": 0}}
 ]
}
