{
 "api": "managedkafka.v1",
 "steps": [
  {"call": "projects.locations.clusters.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "clusterId": "fixture"}, "body": {"capacityConfig": {"vcpuCount": "3", "memoryBytes": "3221225472"}, "gcpConfig": {"accessConfig": {"networkConfigs": [{"subnet": "projects/tenkacloud-local/regions/us-central1/subnetworks/default"}]}}, "labels": {"team": "a"}}, "save": {"op": "name", "cluster": "response.name"}, "expect": {"done": true}},
  {"call": "projects.locations.operations.get", "args": {"name": "${op}"}, "expect": {"response.state": "ACTIVE"}},
  {"call": "projects.locations.operations.list", "args": {"name": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"operations#count": 1}},
  {"call": "projects.locations.clusters.get", "args": {"name": "${cluster}", "view": "CLUSTER_VIEW_FULL"}, "expect": {"labels.team": "a"}},
  {"call": "projects.locations.clusters.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"clusters#count": 1}},
  {"call": "projects.locations.clusters.patch", "args": {"name": "${cluster}", "updateMask": "labels"}, "body": {"labels": {"team": "a", "tier": "gold"}}},
  {"call": "projects.locations.clusters.topics.create", "args": {"parent": "${cluster}", "topicId": "orders.v1"}, "body": {"partitionCount": 3, "replicationFactor": 3}, "save": {"topic": "name"}},
  {"call": "projects.locations.clusters.topics.get", "args": {"name": "${topic}"}, "expect": {"partitionCount": 3}},
  {"call": "projects.locations.clusters.topics.list", "args": {"parent": "${cluster}"}, "expect": {"topics#count": 1}},
  {"call": "projects.locations.clusters.topics.patch", "args": {"name": "${topic}", "updateMask": "configs"}, "body": {"configs": {"cleanup.policy": "compact"}}},
  {"call": "projects.locations.connectClusters.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "connectClusterId": "sink"}, "body": {"kafkaCluster": "${cluster}", "capacityConfig": {"vcpuCount": "3", "memoryBytes": "3221225472"}, "gcpConfig": {"accessConfig": {"networkConfigs": [{"primarySubnet": "projects/tenkacloud-local/regions/us-central1/subnetworks/default"}]}}}, "save": {"connect": "response.name"}},
  {"call": "projects.locations.connectClusters.get", "args": {"name": "${connect}"}, "expect": {"state": "ACTIVE", "kafkaCluster": "${cluster}"}},
  {"call": "projects.locations.connectClusters.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"connectClusters#count": 1}},
  {"call": "projects.locations.connectClusters.patch", "args": {"name": "${connect}", "updateMask": "labels"}, "body": {"labels": {"role": "sink"}}},
  {"call": "projects.locations.clusters.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "clusterId": "tiny"}, "body": {"capacityConfig": {"vcpuCount": "1", "memoryBytes": "1073741824"}, "gcpConfig": {"accessConfig": {"networkConfigs": [{"subnet": "s"}]}}}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "projects.locations.clusters.delete", "args": {"name": "${cluster}"}, "error": "FAILED_PRECONDITION", "status": 400},
  {"call": "projects.locations.clusters.acls.create", "args": {"parent": "${cluster}", "aclId": "cluster", "body": {"aclEntries": [{"principal": "User:*", "permissionType": "ALLOW", "operation": "ALL", "host": "*"}]}}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.locations.clusters.get", "args": {"name": "projects/tenkacloud-local/locations/us-central1/clusters/missing"}, "error": "NOT_FOUND", "status": 404},
  {"call": "projects.locations.clusters.list", "args": {"parent": "projects/other-project/locations/us-central1"}, "error": "PERMISSION_DENIED", "status": 403}
 ],
 "isolation": [
  {"call": "projects.locations.clusters.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"clusters#count": 0}}
 ],
 "after_restart": [
  {"call": "projects.locations.clusters.get", "args": {"name": "${cluster}"}, "expect": {"labels.tier": "gold", "state": "ACTIVE"}},
  {"call": "projects.locations.clusters.topics.get", "args": {"name": "${topic}"}, "expect": {"replicationFactor": 3}}
 ],
 "cleanup": [
  {"call": "projects.locations.connectClusters.delete", "args": {"name": "${connect}"}},
  {"call": "projects.locations.clusters.topics.delete", "args": {"name": "${topic}"}},
  {"call": "projects.locations.clusters.delete", "args": {"name": "${cluster}"}},
  {"call": "projects.locations.clusters.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"clusters#count": 0}},
  {"call": "projects.locations.connectClusters.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"connectClusters#count": 0}}
 ]
}
