{
 "api": "gkebackup.v1",
 "steps": [
  {"call": "projects.locations.backupPlans.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "backupPlanId": "fixture"}, "body": {"cluster": "projects/tenkacloud-local/locations/us-central1/clusters/apps", "backupConfig": {"allNamespaces": true, "includeVolumeData": true}, "labels": {"team": "a"}}, "save": {"op": "name", "plan": "response.name"}, "expect": {"done": true}},
  {"call": "projects.locations.operations.get", "args": {"name": "${op}"}, "expect": {"response.state": "READY"}},
  {"call": "projects.locations.operations.list", "args": {"name": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"operations#count": 1}},
  {"call": "projects.locations.backupPlans.get", "args": {"name": "${plan}"}, "expect": {"backupConfig.includeVolumeData": true}},
  {"call": "projects.locations.backupPlans.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"backupPlans#count": 1}},
  {"call": "projects.locations.backupPlans.patch", "args": {"name": "${plan}", "updateMask": "description"}, "body": {"description": "Fixture"}},
  {"call": "projects.locations.restorePlans.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "restorePlanId": "back"}, "body": {"backupPlan": "${plan}", "cluster": "projects/tenkacloud-local/locations/us-central1/clusters/apps", "restoreConfig": {"allNamespaces": true, "volumeDataRestorePolicy": "RESTORE_VOLUME_DATA_FROM_BACKUP"}}, "save": {"restore": "response.name"}},
  {"call": "projects.locations.restorePlans.get", "args": {"name": "${restore}"}, "expect": {"backupPlan": "${plan}"}},
  {"call": "projects.locations.restorePlans.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"restorePlans#count": 1}},
  {"call": "projects.locations.restorePlans.patch", "args": {"name": "${restore}", "updateMask": "labels"}, "body": {"labels": {"kind": "dr"}}},
  {"call": "projects.locations.restorePlans.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "restorePlanId": "orphan"}, "body": {"backupPlan": "projects/tenkacloud-local/locations/us-central1/backupPlans/missing", "cluster": "projects/tenkacloud-local/locations/us-central1/clusters/apps", "restoreConfig": {"allNamespaces": true}}, "error": "NOT_FOUND", "status": 404},
  {"call": "projects.locations.backupPlans.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "backupPlanId": "locked"}, "body": {"cluster": "projects/tenkacloud-local/locations/us-central1/clusters/apps", "retentionPolicy": {"locked": true}}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "projects.locations.backupPlans.backups.create", "args": {"parent": "${plan}", "backupId": "now", "body": {}}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.locations.backupPlans.list", "args": {"parent": "projects/other-project/locations/us-central1"}, "error": "PERMISSION_DENIED", "status": 403}
 ],
 "isolation": [
  {"call": "projects.locations.backupPlans.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"backupPlans#count": 0}}
 ],
 "after_restart": [
  {"call": "projects.locations.restorePlans.get", "args": {"name": "${restore}"}, "expect": {"labels.kind": "dr"}}
 ],
 "cleanup": [
  {"call": "projects.locations.restorePlans.delete", "args": {"name": "${restore}"}},
  {"call": "projects.locations.backupPlans.delete", "args": {"name": "${plan}"}},
  {"call": "projects.locations.backupPlans.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"backupPlans#count": 0}},
  {"call": "projects.locations.restorePlans.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"restorePlans#count": 0}}
 ]
}
