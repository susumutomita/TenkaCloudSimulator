{
 "api": "file.v1",
 "steps": [
  {"call": "projects.locations.instances.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "instanceId": "fixture"}, "body": {"tier": "BASIC_HDD", "fileShares": [{"name": "share", "capacityGb": "1024"}], "networks": [{"network": "default"}], "labels": {"team": "a"}}, "save": {"op": "name", "instance": "response.name"}, "expect": {"done": true}},
  {"call": "projects.locations.operations.get", "args": {"name": "${op}"}, "expect": {"response.state": "READY"}},
  {"call": "projects.locations.operations.list", "args": {"name": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"operations#count": 1}},
  {"call": "projects.locations.instances.get", "args": {"name": "${instance}"}, "expect": {"labels.team": "a", "fileShares[0].name": "share"}},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"instances#count": 1}},
  {"call": "projects.locations.instances.patch", "args": {"name": "${instance}", "updateMask": "description"}, "body": {"description": "Fixture"}},
  {"call": "projects.locations.instances.snapshots.create", "args": {"parent": "${instance}", "snapshotId": "snap"}, "body": {"description": "first"}, "save": {"snapshot": "response.name"}},
  {"call": "projects.locations.instances.snapshots.get", "args": {"name": "${snapshot}"}, "expect": {"state": "READY"}},
  {"call": "projects.locations.instances.snapshots.list", "args": {"parent": "${instance}"}, "expect": {"snapshots#count": 1}},
  {"call": "projects.locations.instances.snapshots.patch", "args": {"name": "${snapshot}", "updateMask": "labels"}, "body": {"labels": {"kind": "manual"}}},
  {"call": "projects.locations.backups.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "backupId": "nightly"}, "body": {"sourceInstance": "${instance}", "sourceFileShare": "share"}, "save": {"backup": "response.name"}},
  {"call": "projects.locations.backups.get", "args": {"name": "${backup}"}, "expect": {"sourceInstance": "${instance}"}},
  {"call": "projects.locations.backups.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"backups#count": 1}},
  {"call": "projects.locations.backups.patch", "args": {"name": "${backup}", "updateMask": "description"}, "body": {"description": "Nightly"}},
  {"call": "projects.locations.backups.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "backupId": "orphan"}, "body": {"sourceInstance": "projects/tenkacloud-local/locations/us-central1/instances/missing", "sourceFileShare": "share"}, "error": "NOT_FOUND", "status": 404},
  {"call": "projects.locations.instances.create", "args": {"parent": "projects/tenkacloud-local/locations/us-central1", "instanceId": "tagged"}, "body": {"tags": {"123/env": "prod"}}, "error": "INVALID_ARGUMENT", "status": 400},
  {"call": "projects.locations.instances.delete", "args": {"name": "${instance}"}, "error": "FAILED_PRECONDITION", "status": 400},
  {"call": "projects.locations.instances.restore", "args": {"name": "${instance}", "body": {"fileShare": "share", "sourceBackup": "${backup}"}}, "error": "UNIMPLEMENTED", "status": 501},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/other-project/locations/us-central1"}, "error": "PERMISSION_DENIED", "status": 403}
 ],
 "isolation": [
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"instances#count": 0}}
 ],
 "after_restart": [
  {"call": "projects.locations.instances.get", "args": {"name": "${instance}"}, "expect": {"description": "Fixture"}},
  {"call": "projects.locations.instances.snapshots.get", "args": {"name": "${snapshot}"}, "expect": {"labels.kind": "manual"}}
 ],
 "cleanup": [
  {"call": "projects.locations.backups.delete", "args": {"name": "${backup}"}},
  {"call": "projects.locations.instances.snapshots.delete", "args": {"name": "${snapshot}"}},
  {"call": "projects.locations.instances.delete", "args": {"name": "${instance}"}},
  {"call": "projects.locations.instances.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"instances#count": 0}},
  {"call": "projects.locations.backups.list", "args": {"parent": "projects/tenkacloud-local/locations/us-central1"}, "expect": {"backups#count": 0}}
 ]
}
