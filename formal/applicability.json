    {
      "path": "formal/ConsoleHandoff.cfg",
      "sha256": "75ae4c45b581f355acedd7a33c6589feb785b463c62071fdbdb913917a5f9751",
      "disposition": "modeled",
      "reason": "Instance target kind for the console handoff: ConsoleInstanceBinding reuses the terminal binding checks, the console session is limited to EC2 discovery of its own instance, readiness and the terminal routes, and a terminal start requires an answering relay. ConsoleHandoff.tla adds kind/relay with ExactDestination and TerminalRequiresRelay plus CrossKindAction and SkipRelay controls.",
      "models": [
        {
          "id": "ConsoleHandoff",
          "properties": [
            "OperatorRefused",
            "ParentLifetimeBound",
            "OneTimeRedemption",
            "AttemptConsumesCode",
            "RedeemRequiresFreshParent",
            "UseRequiresFreshAuthority",
            "ExactDestination",
            "TerminalRequiresRelay",
            "LogoutRejectsReplay",
            "UnrelatedSessionsPreserved",
            "SDKAuthorityPreserved"
          ],
          "limits": "Finite abstract lifecycle only; no Go/HTTP/SQL/crypto refinement, UI behavior, URL canonicalization, header ambiguity, terminal channel/token/I-O, or guest relay protocol. Native Go tests and an owner-run real guest check are separate."
