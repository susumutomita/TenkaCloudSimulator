{
  "version": 1,
  "tool": {
    "version": "1.7.4",
    "checksum_file": "formal/tla2tools.sha256",
    "release_url": "https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar"
  },
  "models": [
    {
      "id": "ObjectStore",
      "model": "formal/ObjectStore.tla",
      "config": "formal/ObjectStore.cfg",
      "bounds": "Two bucket names, two keys, Boolean allow and deny.",
      "properties": [
        "TypeOK",
        "NoOrphans",
        "NoUnauthorizedMutation",
        "DenyWins"
      ],
      "limits": "Abstract authorization and atomic transitions only; not IAM parsing/ARN matching, SQL, HTTP, quotas, crashes or a Go refinement proof.",
      "source_scope": [
        "internal/core/store.go",
        "internal/core/policy.go",
        "internal/aws/s3.go"
      ],
      "mutants": [
        {
          "id": "MissingDeletionGuard",
          "edits": [
            {
              "old": "ObjectsFor(b) = {}",
              "new": "TRUE",
              "count": 1
            }
          ],
          "expect_invariant": "NoOrphans"
        }
      ]
    },
    {
      "id": "StackOwnership",
      "model": "formal/StackOwnership.tla",
      "config": "formal/StackOwnership.cfg",
      "bounds": "Two owners and two physical names with retained drift claims.",
      "properties": [
        "TypeOK",
        "OwnershipExclusive"
      ],
      "limits": "Exclusive reservation and cleanup abstraction only; not authentication, SQL crash recovery, custom callbacks or full CFN behavior.",
      "source_scope": [
        "internal/aws/cloudformation.go",
        "internal/aws/s3_cloudformation.go",
        "internal/aws/apigateway_cloudformation.go"
      ],
      "mutants": [
        {
          "id": "ReclaimDriftedResource",
          "edits": [
            {
              "old": "/\\ Unclaimed(p)",
              "new": "/\\ p \\notin present",
              "count": 1
            }
          ],
          "expect_invariant": "OwnershipExclusive"
        }
      ]
    },
    {
      "id": "S3Versions",
      "model": "formal/S3Versions.tla",
      "config": "formal/S3Versions.cfg",
      "bounds": "One bucket, two keys, bounded enabled history and delete markers.",
      "properties": [
        "TypeOK",
        "NoHistoryOrphans",
        "CurrentMatchesLatest"
      ],
      "limits": "Enabled version history only; suspension, byte/version IDs, quotas, SQL and HTTP are independently tested.",
      "source_scope": [
        "internal/aws/s3_versions.go",
        "internal/aws/s3_list_versions.go",
        "internal/aws/s3_configuration.go",
        "internal/aws/s3_cloudformation.go"
      ],
      "mutants": [
        {
          "id": "CurrentOnlyDeletion",
          "edits": [
            {
              "old": "bucket /\\ EmptyHistory",
              "new": "bucket /\\ current = {}",
              "count": 1
            }
          ],
          "expect_invariant": "NoHistoryOrphans"
        }
      ]
    },
    {
      "id": "NativeIAMOwnership",
      "model": "formal/NativeIAMOwnership.tla",
      "config": "formal/NativeIAMOwnership.cfg",
      "bounds": "Two case-folded names; native active/retired claims and legacy identities.",
      "properties": [
        "TypeOK",
        "OwnershipExclusive"
      ],
      "limits": "Atomic name ownership abstraction only; not service trust parsing, complete IAM semantics, SQL isolation or HTTP authorization.",
      "source_scope": [
        "internal/aws/iam_roles.go",
        "internal/aws/iam_legacy.go",
        "internal/aws/iam_query.go",
        "internal/core/policy.go",
        "internal/server/identity.go"
      ],
      "mutants": [
        {
          "id": "LegacyAdoptsNativeRole",
          "edits": [
            {
              "old": "LegacyPut(n) == /\\ n \\notin claimed",
              "new": "LegacyPut(n) == /\\ TRUE",
              "count": 1
            }
          ],
          "expect_invariant": "OwnershipExclusive"
        }
      ]
    },
    {
      "id": "RESTDeploymentSnapshot",
      "model": "formal/RESTDeploymentSnapshot.tla",
      "config": "formal/RESTDeploymentSnapshot.cfg",
      "bounds": "One API, two deployment IDs, two handler configurations and one stage.",
      "properties": [
        "TypeOK",
        "SnapshotsFrozen",
        "NoStageOrphans"
      ],
      "limits": "Frozen deployment references only; not path matcher correctness, Lambda permissions, HTTP execution, WASI, SQL recovery or WAF.",
      "source_scope": [
        "internal/aws/apigateway_store.go",
        "internal/aws/apigateway_resources.go",
        "internal/aws/apigateway_deployments.go",
        "internal/aws/apigateway_routing.go"
      ],
      "mutants": [
        {
          "id": "MutableSnapshot",
          "edits": [
            {
              "old": "/\\ UNCHANGED <<exists, snapshots, baseline, stage>>",
              "new": "/\\ snapshots' = [d \\in Deployments |-> IF snapshots[d] = None THEN None ELSE v] /\\ UNCHANGED <<exists, baseline, stage>>",
              "count": 1
            }
          ],
          "expect_invariant": "SnapshotsFrozen"
        }
      ]
    },
    {
      "id": "SecretsVersionLifecycle",
      "model": "formal/SecretsVersionLifecycle.tla",
      "config": "formal/SecretsVersionLifecycle.cfg",
      "bounds": "teams=2; versionsPerIncarnation=2; dummyValues=2; incarnationsPerTeam=2.",
      "properties": [
        "TypeOK",
        "ImmutableVersions",
        "NoOrphans",
        "UniqueLabels",
        "SeparateCurrentPrevious",
        "ActiveHasCurrent",
        "AuthorizedVersions",
        "AuthorizedDisclosure"
      ],
      "limits": "Finite lifecycle/authority abstraction, not SQL transaction, cryptography, OS authentication, formatter redaction or Go implementation refinement. A team models one secret name and two never-reused ARN incarnations; process/token isolation and cursor bindings require actual native SDK tests. History contains abstract dummy values solely to detect an attempted immutable-version overwrite; runtime force deletion does not retain secret values. IAM is represented by a pure Boolean decision for the resolved resource; policy loading/error ordering and actual IAM rules require concrete Go tests. Shared Gateway/dispatch/server paths bind only Secrets composition into the native SQLite/immutable-policy authority path, not unrelated S3/SSM behavior or a proof of HTTP routing. Cursor signatures, quotas and restart persistence require concrete tests.",
      "source_scope": [
        "internal/aws/secret_store.go",
        "internal/aws/secret_values.go",
        "internal/aws/secret_query.go",
        "internal/aws/secret_gateway.go",
        "internal/aws/s3.go",
        "internal/aws/ssm.go",
        "internal/server/server.go"
      ],
      "mutants": [
        {
          "id": "OverwriteConflictingVersion",
          "edits": [
            {
              "old": "                         /\\ UNCHANGED vars",
              "new": "                         /\\ versions'={stored \\in versions : ~(stored.team=t /\\ stored.gen=generation[t] /\\ stored.id=i)} \\cup {Record(t,generation[t],i,v,a)}\n                         /\\ history'=history \\cup {Record(t,generation[t],i,v,a)}\n                         /\\ UNCHANGED <<active,generation,current,previous,receipts>>",
              "count": 1
            }
          ],
          "expect_invariant": "ImmutableVersions"
        },
        {
          "id": "RetainDeletedVersions",
          "edits": [
            {
              "old": "/\\ versions'={r \\in versions : r.team#t}",
              "new": "/\\ versions'=versions",
              "count": 1
            }
          ],
          "expect_invariant": "NoOrphans"
        },
        {
          "id": "RetainPreviousLabelOnPromote",
          "edits": [
            {
              "old": "/\\ previous'=[previous EXCEPT ![t]={remove}]",
              "new": "/\\ previous'=[previous EXCEPT ![t]=@ \\cup {remove}]",
              "count": 1
            }
          ],
          "expect_invariant": "UniqueLabels"
        },
        {
          "id": "OmitCreatePermission",
          "edits": [
            {
              "old": "/\\ t \\notin active /\\ generation[t]<2 /\\ a",
              "new": "/\\ t \\notin active /\\ generation[t]<2",
              "count": 1
            }
          ],
          "expect_invariant": "AuthorizedVersions"
        },
        {
          "id": "OmitReadTeamBinding",
          "edits": [
            {
              "old": "/\\ t \\in active /\\ caller=t /\\ g=generation[t] /\\ a",
              "new": "/\\ t \\in active /\\ g=generation[t] /\\ a",
              "count": 1
            }
          ],
          "expect_invariant": "AuthorizedDisclosure"
        },
        {
          "id": "OmitReadGenerationBinding",
          "edits": [
            {
              "old": "/\\ t \\in active /\\ caller=t /\\ g=generation[t] /\\ a",
              "new": "/\\ t \\in active /\\ caller=t /\\ a",
              "count": 1
            }
          ],
          "expect_invariant": "AuthorizedDisclosure"
        }
      ]
    },
    {
      "id": "SecretsRevealEpoch",
      "model": "formal/SecretsRevealEpoch.tla",
      "config": "formal/SecretsRevealEpoch.cfg",
      "bounds": "resources=2; requestOrNavigationEpochs=2; componentLifetimes=1.",
      "properties": [
        "TypeOK",
        "NoUnmountedDisplay",
        "FreshEmissionHistory",
        "ReturnedARNMatches",
        "VisibleContextMatches"
      ],
      "limits": "Finite explicit-retrieve/display model, not React, DOM, AbortController, memory zeroization or implementation refinement. Only the successful response path is modeled; native store/IAM must authorize before returning any secret. A returned ARN can differ and must be rejected. Retrieve, Hide and navigation invalidate epochs; unmount also clears visible state. Parent must remount on region/principal changes. Emission history captures the context at each acceptance so later Hide/navigation cannot relabel an earlier stale acceptance. Draft entry, mutation atomicity and form layout are outside this model.",
      "source_scope": [
        "tools/console/src/secrets-manager.jsx"
      ],
      "mutants": [
        {
          "id": "OmitReplyEpoch",
          "edits": [
            {
              "old": "/\\ alive /\\ req.ticket=epoch /\\ returned=req.resource",
              "new": "/\\ alive /\\ returned=req.resource",
              "count": 1
            }
          ],
          "expect_invariant": "FreshEmissionHistory"
        },
        {
          "id": "OmitResponseArnBinding",
          "edits": [
            {
              "old": "/\\ alive /\\ req.ticket=epoch /\\ returned=req.resource",
              "new": "/\\ alive /\\ req.ticket=epoch",
              "count": 1
            }
          ],
          "expect_invariant": "ReturnedARNMatches"
        },
        {
          "id": "RetainVisibleValueOnUnmount",
          "edits": [
            {
              "old": "/\\ alive'=FALSE /\\ epoch'=epoch+1 /\\ visible'={}",
              "new": "/\\ alive'=FALSE /\\ epoch'=epoch+1 /\\ visible'=visible",
              "count": 1
            }
          ],
          "expect_invariant": "NoUnmountedDisplay"
        }
      ]
    },
    {
      "id": "SecretsDisclosureChannels",
      "model": "formal/SecretsDisclosureChannels.tla",
      "config": "formal/SecretsDisclosureChannels.cfg",
      "bounds": "Four operation contexts, Boolean native authorization, four output sinks, and at most two captured emissions.",
      "properties": [
        "TypeOK",
        "RawRequiresAuthorizedGet",
        "MetadataLogErrorRedacted",
        "DeniedNoRaw",
        "RawEmissionRequiresGet"
      ],
      "limits": "Finite classification of plaintext acquisition/output call sites, not Go fmt/JSON/slog, SQL, encryption, memory secrecy or implementation refinement. The private plaintext() accessor itself has no authorization: its only production writer call site must follow successful native Get authorization. Actual private-holder formatting/JSON/slog sentinel tests and native denied-Get/error/metadata tests verify the Go mechanisms independently.",
      "source_scope": [
        "internal/aws/secret_material.go",
        "internal/aws/secret_http.go"
      ],
      "mutants": [
        {
          "id": "RawAccessorForMetadata",
          "edits": [
            {
              "old": "AcquireRaw == /\\ context.operation=GetValue /\\ context.allowed",
              "new": "AcquireRaw == /\\ context.allowed",
              "count": 1
            }
          ],
          "expect_invariant": "RawRequiresAuthorizedGet"
        },
        {
          "id": "RawAccessorDenied",
          "edits": [
            {
              "old": "AcquireRaw == /\\ context.operation=GetValue /\\ context.allowed",
              "new": "AcquireRaw == /\\ context.operation=GetValue",
              "count": 1
            }
          ],
          "expect_invariant": "RawRequiresAuthorizedGet"
        },
        {
          "id": "PrivateSinkGetsRaw",
          "edits": [
            {
              "old": "Emission(sink,FALSE)",
              "new": "Emission(sink,TRUE)",
              "count": 1
            }
          ],
          "expect_invariant": "MetadataLogErrorRedacted"
        },
        {
          "id": "RetainRawAcrossContext",
          "edits": [
            {
              "old": "/\\ raw'=FALSE",
              "new": "/\\ raw'=raw",
              "count": 1
            }
          ],
          "expect_invariant": "RawRequiresAuthorizedGet"
        },
        {
          "id": "DirectDeniedGetWriter",
          "edits": [
            {
              "old": "/\\ context.operation=GetValue /\\ context.allowed /\\ raw",
              "new": "/\\ TRUE",
              "count": 1
            }
          ],
          "expect_invariant": "DeniedNoRaw"
        }
      ]
    }
  ]
}
