 "info": {
  "description": "Bounded simulator subset of the official AWS CodeCommit API (2015-04-13). Every other official operation returns HTTP 501 UnknownOperationException. Repositories are configuration metadata without Git data: no Git endpoint is served at the official clone URLs, and branches, commits, files, pull requests, comments, merges and triggers return UnknownOperationException with HTTP 501. KMS key identifiers are stored without resolving them. Repositories cannot be renamed. Deleting a missing repository fails instead of returning an empty result, and sortBy/order are refused.",
  "title": "AWS CodeCommit (simulator catalog)",
  "version": "2015-04-13"
 },
 "openapi": "3.1.0",
