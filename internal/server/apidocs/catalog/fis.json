 "info": {
  "description": "Bounded simulator subset of the official AWS Fault Injection Simulator API (2020-12-01). Every other official operation returns HTTP 501 UnknownOperationException. Experiment templates are stored metadata: StartExperiment, StopExperiment and every experiment, action, target resource type and safety lever operation return UnknownOperationException with HTTP 501, so no fault is ever injected, no target is resolved, no role is assumed and no log or report is written. Action identifiers, target resource types, selection modes, filters and alarm ARNs are stored without checking the AWS action catalog or the named resources; experiment options default to single-account targeting and the fail empty-target mode. Multi-account targeting and target account configurations are refused, and UpdateExperimentTemplate refuses experimentOptions.",
  "title": "AWS Fault Injection Service (simulator catalog)",
  "version": "2020-12-01"
 },
 "openapi": "3.1.0",
