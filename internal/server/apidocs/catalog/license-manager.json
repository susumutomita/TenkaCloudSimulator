 "info": {
  "description": "Bounded simulator subset of the official AWS License Manager API (2018-08-01). Every other official operation returns HTTP 501 UnknownOperationException. License configurations are stored metadata: no instance, host, AMI or database is discovered, associated or counted, license rules and product information filters are not evaluated, so ConsumedLicenses stays 0 and the consumed and managed resource summaries stay empty. ListLicenseConfigurations selects by LicenseConfigurationArns only and refuses Filters; a missing ARN is refused instead of omitted. Seller-issued licenses, grants, tokens, checkouts, report generators, conversion tasks, asset groups, inventory and service settings return UnknownOperationException with HTTP 501.",
  "title": "AWS License Manager (simulator catalog)",
  "version": "2018-08-01"
 },
 "openapi": "3.1.0",
