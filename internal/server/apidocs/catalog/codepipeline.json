 "info": {
  "description": "Bounded simulator subset of the official AWS CodePipeline API (2015-07-09). Every other official operation returns HTTP 501 UnknownOperationException. Pipelines are stored declarations at version 1 after the documented structural checks: at least two stages, source actions only and always in the first stage, unique stage and action names, and exactly one artifact store setting. Action providers, roles and artifact buckets are stored without contacting them; GetPipeline returns no metadata. Only AWS-owned actions are accepted. Pipeline executions, approvals, stage transitions, jobs, webhooks, custom action types and UpdatePipeline return UnknownOperationException with HTTP 501.",
  "title": "AWS CodePipeline (simulator catalog)",
  "version": "2015-07-09"
 },
 "openapi": "3.1.0",
