 "info": {
  "description": "Bounded simulator subset of the official EC2 Image Builder API (2019-12-02). Every other official operation returns HTTP 501 UnknownOperationException. Distribution configurations and lifecycle policies are configuration metadata: no AMI or container image is copied, distributed, deprecated or deleted, and lifecycle policies never run. Names must be lowercase letters, digits, hyphens and underscores so the ARN keeps the name unchanged. Update client tokens are accepted but not recorded. List filters are refused. Components, recipes, workflows, infrastructure configurations, image pipelines and images are not implemented; CreateImage, StartImagePipelineExecution and other build APIs return UnknownOperationException with HTTP 501.",
  "title": "EC2 Image Builder (simulator catalog)",
  "version": "2019-12-02"
 },
 "openapi": "3.1.0",
