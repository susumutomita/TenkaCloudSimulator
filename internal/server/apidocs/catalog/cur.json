 "info": {
  "description": "Bounded simulator subset of the official AWS Cost and Usage Report Service API (2017-01-06). Every other official operation returns HTTP 501 UnknownOperationException. Report definitions are stored configuration: no cost or usage report is generated or refreshed, nothing is written to the named Amazon S3 bucket, which is not checked, and no Athena, Amazon Redshift or Amazon QuickSight artifact is produced. ReportStatus and BillingViewArn are refused; report definitions are kept per simulator Region although AWS serves this API from us-east-1 only. Tags supplied at creation are stored, but TagResource, UntagResource and ListTagsForResource are not implemented because they identify the report by name rather than ARN.",
  "title": "AWS Cost and Usage Report Service (simulator catalog)",
  "version": "2017-01-06"
 },
 "openapi": "3.1.0",
