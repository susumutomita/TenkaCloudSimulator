 "info": {
  "description": "Bounded simulator subset of the official Managed Streaming for Kafka API (2018-11-14). Every other official operation returns HTTP 501 UnknownOperationException. Provisioned clusters are configuration records that stay CREATING: no broker, ZooKeeper or KRaft controller, topic, bootstrap endpoint or network interface exists, no record is produced or consumed, and GetBootstrapBrokers, topic, replicator, VPC connection and SCRAM secret APIs return UnknownOperationException with HTTP 501. The V2 and serverless APIs, configurations (whose server properties need revision storage), ConfigurationInfo, cluster policies and every cluster update operation are not implemented. CurrentVersion is the constant K1 because no update is possible, and DeleteCluster refuses any other version. NumberOfBrokerNodes must be a multiple of the number of client subnets; subnets, security groups, certificate authorities, KMS keys and log destinations are stored without being checked. ListClusters refuses ClusterNameFilter.",
  "title": "Amazon Managed Streaming for Apache Kafka (simulator catalog)",
  "version": "2018-11-14"
 },
 "openapi": "3.1.0",
 "paths": {
  "/v1/clusters": {
   "get": {
    "operationId": "kafkaListClusters",
    "parameters": [
     {
      "description": "Routes an unsigned first-party request; SDKs use the SigV4 credential scope instead.",
      "in": "header",
      "name": "X-Simulator-Service",
      "required": false,
      "schema": {
       "enum": [
        "kafka"
       ],
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "clusterNameFilter",
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "maxResults",
      "schema": {
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "nextToken",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "properties": {
          "clusterInfoList": {
           "items": {
            "$ref": "#/components/schemas/ClusterInfo"
           },
           "type": "array"
          },
          "nextToken": {
           "type": "string"
          }
         },
         "type": "object"
        }
       }
      },
      "description": "Projected official output shape."
     },
     "400": {
      "description": "Modeled exception named by X-Amzn-ErrorType."
     },
     "403": {
      "description": "AccessDeniedException."
     },
     "404": {
      "description": "Not found or no matching official route."
     }
    },
    "summary": "ListClusters",
    "tags": [
     "Amazon Managed Streaming for Apache Kafka"
    ]
   },
