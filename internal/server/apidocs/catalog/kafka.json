         "numberOfBrokerNodes": {
          "maximum": 15,
          "minimum": 1,
          "type": "integer"
         },
         "openMonitoring": {
          "$ref": "#/components/schemas/OpenMonitoringInfo"
         },
         "rebalancing": {
          "$ref": "#/components/schemas/Rebalancing"
         },
         "storageMode": {
          "enum": [
           "LOCAL",
           "TIERED"
          ],
          "type": "string"
