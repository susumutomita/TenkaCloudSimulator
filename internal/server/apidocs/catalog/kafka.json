         "enhancedMonitoring": {
          "enum": [
           "DEFAULT",
           "PER_BROKER",
           "PER_TOPIC_PER_BROKER",
           "PER_TOPIC_PER_PARTITION"
          ],
          "type": "string"
         },
         "kafkaVersion": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
         },
         "loggingInfo": {
          "$ref": "#/components/schemas/LoggingInfo"
