 "info": {
  "description": "Bounded simulator subset of the official AWS Certificate Manager Private Certificate Authority API (2017-08-22). Every other official operation returns HTTP 501 UnknownOperationException. Certificate authorities are configuration metadata that stay PENDING_CERTIFICATE: no key pair, CSR, CA certificate, CRL, OCSP response or audit report is generated, and nothing is written to S3. IssueCertificate, GetCertificate, GetCertificateAuthorityCsr, ImportCertificateAuthorityCertificate, RevokeCertificate, UpdateCertificateAuthority, RestoreCertificateAuthority, permissions and policies return UnknownOperationException with HTTP 501. DeleteCertificateAuthority removes the authority immediately instead of keeping a restorable DELETED state; PermanentDeletionTimeInDays and IdempotencyToken are refused. ListCertificateAuthorities returns no authorities for ResourceOwner OTHER_ACCOUNTS. UntagCertificateAuthority is not implemented because its key/value removal list has no catalog tag binding.",
  "title": "AWS Certificate Manager Private Certificate Authority (simulator catalog)",
  "version": "2017-08-22"
 },
 "openapi": "3.1.0",
 "paths": {
  "/": {
   "post": {
