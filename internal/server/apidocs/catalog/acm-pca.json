         "value": {}
        },
        "DescribeCertificateAuthority": {
         "summary": "X-Amz-Target: ACMPrivateCA.DescribeCertificateAuthority",
         "value": {}
        },
        "ListCertificateAuthorities": {
         "summary": "X-Amz-Target: ACMPrivateCA.ListCertificateAuthorities",
         "value": {}
        },
        "ListTags": {
         "summary": "X-Amz-Target: ACMPrivateCA.ListTags",
         "value": {}
        },
        "TagCertificateAuthority": {
         "summary": "X-Amz-Target: ACMPrivateCA.TagCertificateAuthority",
         "value": {}
        }
       },
       "schema": {
        "type": "object"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/x-amz-json-1.1": {
        "schema": {
         "type": "object"
        }
       }
      },
      "description": "Projected official output shape."
     },
     "400": {
      "description": "Modeled exception in __type."
     },
     "403": {
      "description": "AccessDeniedException from local identity policy evaluation."
     },
     "501": {
      "description": "Official operation not implemented by the simulator."
     }
    },
    "summary": "AWS Certificate Manager Private Certificate Authority JSON 1.1 operations",
    "tags": [
     "AWS Certificate Manager Private Certificate Authority"
    ]
   }
  }
 },
