 "servers": [
  {
   "description": "This simulator only",
   "url": "/"
  }
 ],
 "tags": [
  {
   "description": "Bounded simulator subset of the official Elastic Disaster Recovery Service API (2020-02-26). Every other official operation returns HTTP 501 UnknownOperationException. Launch and replication configuration templates and the launch actions of launch templates are stored configuration: no source server, replication agent, staging area, replication server, recovery instance, drill, recovery or failback job exists, nothing replicates, and every source server, recovery instance, job, source network and extensible source server operation, StartRecovery, StartReplication, ReverseReplication, InitializeService and the other official operations return UnknownOperationException with HTTP 501. UninitializedAccountException is never returned because no service-linked role is needed. PutLaunchAction accepts only a launch configuration template ID as resourceId; a source server ID does not exist and fails with ResourceNotFoundException. The action type member is never reported because the service derives it from the SSM document, which is not resolved, and the filters member of ListLaunchActions is refused instead of being ignored. Deleting a launch configuration template deletes its launch actions. Template members that are not supplied are not defaulted, and subnet, security group, KMS key, S3 bucket and SSM document references are stored as given and never resolved. The ARN forms launch-configuration-template/{id}, replication-configuration-template/{id} and launch-configuration-template/{id}/launch-action/{actionId} are the simulator's reading of the authorization reference. At most 20 templates of each kind and 50 launch actions per template exist per Region as local limits.",
   "name": "AWS Elastic Disaster Recovery"
  }
 ],
