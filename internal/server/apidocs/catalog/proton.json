 "info": {
  "description": "Bounded simulator subset of the official AWS Proton API (2020-07-20). Every other official operation returns HTTP 501 UnknownOperationException. Environment and service templates are stored metadata without versions, so recommendedVersion is never set; no template bundle is read from Amazon S3 or a repository and the encryption key is not used. Template versions, environments, services, service instances, pipelines, components, repositories, sync configurations, deployments and account settings return UnknownOperationException with HTTP 501, so nothing is provisioned or deployed. ListTagsForResource returns every tag in one page and refuses maxResults and nextToken.",
  "title": "AWS Proton (simulator catalog)",
  "version": "2020-07-20"
 },
 "openapi": "3.1.0",
