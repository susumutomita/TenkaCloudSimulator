 "info": {
  "description": "Bounded simulator subset of the official Amazon EMR API (2009-03-31). Every other official operation returns HTTP 501 UnknownOperationException. Security configurations and the Regional block public access setting are stored records: no cluster, instance group, step, notebook, studio or session exists, nothing is launched and no security group rule is checked or changed. RunJobFlow and every other official operation return UnknownOperationException with HTTP 501, including Studio operations because a Studio returns a web address. A security configuration is a JSON document that must parse as an object; its contents are stored without being checked against EMR's encryption, authentication and authorization schema, and no certificate, key or role it names is resolved. It cannot be updated and has no tags, and its ARN is a simulator form used only for authorization, because AWS gives security configurations none. The block public access setting defaults to blocking public security group rules with port 22 permitted, as AWS does. After PutBlockPublicAccessConfiguration, the metadata reports the time of the change and the account root ARN as the creator because the simulator does not authenticate callers, and the default reports a creation time of 0. Port ranges must have MinRange not above MaxRange and must not repeat. The limit of 100 security configurations per Region is local.",
  "title": "Amazon EMR (simulator catalog)",
  "version": "2009-03-31"
 },
 "openapi": "3.1.0",
 "paths": {
  "/": {
   "post": {
    "description": "Choose the X-Amz-Target of one implemented operation. Request and response members follow the linked official input/output schemas.",
    "operationId": "emrJSONOperation",
    "parameters": [
     {
      "in": "header",
      "name": "X-Amz-Target",
      "required": true,
      "schema": {
       "enum": [
        "ElasticMapReduce.CreateSecurityConfiguration",
        "ElasticMapReduce.DeleteSecurityConfiguration",
        "ElasticMapReduce.DescribeSecurityConfiguration",
