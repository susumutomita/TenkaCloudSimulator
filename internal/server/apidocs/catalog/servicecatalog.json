 "info": {
  "description": "Bounded simulator subset of the official AWS Service Catalog API (2015-12-10). Every other official operation returns HTTP 501 UnknownOperationException. Portfolios are stored metadata: products, provisioning artifacts, launches, provisioned products, constraints, principal and product associations, sharing, TagOptions and budgets are not implemented and return UnknownOperationException with HTTP 501. Tags are set only at creation; UpdatePortfolio refuses AddTags and RemoveTags, and AcceptLanguage is accepted only as en.",
  "title": "AWS Service Catalog (simulator catalog)",
  "version": "2015-12-10"
 },
 "openapi": "3.1.0",
