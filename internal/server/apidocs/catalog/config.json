 "info": {
  "description": "Bounded simulator subset of the official AWS Config API (2014-11-12). Every other official operation returns HTTP 501 UnknownOperationException. Stored queries and the default retention configuration are stored metadata: no configuration item is recorded, retained, aggregated or queried, and query expressions are neither parsed nor run. PutStoredQuery only creates a query; a second PutStoredQuery with an existing QueryName is refused with ValidationException instead of updating it, so delete the query before replacing it. Configuration recorders, delivery channels, config rules, conformance packs, remediation, aggregators and evaluations return UnknownOperationException with HTTP 501.",
  "title": "AWS Config (simulator catalog)",
  "version": "2014-11-12"
 },
 "openapi": "3.1.0",
