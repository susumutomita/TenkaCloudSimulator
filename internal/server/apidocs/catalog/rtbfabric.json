 "info": {
  "description": "Bounded simulator subset of the official RTBFabric API (2023-05-15). Every other official operation returns HTTP 501 UnknownOperationException. Requester and responder gateways are ACTIVE configuration metadata: VPC, subnet, security group, Auto Scaling group, EKS endpoint and trust store settings are stored without checking them, no network interface or endpoint is created, no domain name is assigned to a requester gateway and no bid request is accepted or forwarded. Links, inbound and outbound external links and link module flows are not implemented, so link counts stay 0; CreateLink, AcceptLink, CreateInboundExternalLink and their other operations return UnknownOperationException with HTTP 501. Update client tokens are accepted but not recorded.",
  "title": "AWS RTB Fabric (simulator catalog)",
  "version": "2023-05-15"
 },
 "openapi": "3.1.0",
