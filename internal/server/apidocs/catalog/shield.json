 "info": {
  "description": "Bounded simulator subset of the official AWS Shield API (2016-06-02). Every other official operation returns HTTP 501 UnknownOperationException. Protections and protection groups are configuration metadata that behave as if a Shield Advanced subscription exists: no traffic is inspected or mitigated, no attack is detected and no subscription or billing commitment is made. Protected resource ARNs must name a supported resource type but are not checked against other services; DescribeProtection looks up by ProtectionId only, and list InclusionFilters are refused. Subscriptions, attacks, DRT access, health checks, emergency contacts, proactive engagement, application-layer automatic response and UpdateProtectionGroup return UnknownOperationException with HTTP 501.",
  "title": "AWS Shield (simulator catalog)",
  "version": "2016-06-02"
 },
 "openapi": "3.1.0",
