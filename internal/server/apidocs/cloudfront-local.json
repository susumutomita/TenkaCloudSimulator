          "400": {
            "description": "Malformed or unsupported input."
          },
          "403": {
            "description": "Denied exact CloudFront action/resource."
          },
          "404": {
            "description": "No such saved distribution/origin/invalidation."
          },
          "500": {
            "description": "State failure; transaction is rolled back."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": {
                "type": "string"
              },
              "example": "<DistributionConfig xmlns=\"http://cloudfront.amazonaws.com/doc/2020-05-31/\"><CallerReference>local-content</CallerReference><Origins><Quantity>1</Quantity><Items><Origin><Id>saved</Id><DomainName>cloudfront-local-origin.s3.amazonaws.com</DomainName><S3OriginConfig><OriginAccessIdentity></OriginAccessIdentity></S3OriginConfig></Origin></Items></Origins><DefaultCacheBehavior><TargetOriginId>saved</TargetOriginId><ViewerProtocolPolicy>allow-all</ViewerProtocolPolicy><AllowedMethods><Quantity>2</Quantity><Items><Method>GET</Method><Method>HEAD</Method></Items><CachedMethods><Quantity>2</Quantity><Items><Method>GET</Method><Method>HEAD</Method></Items></CachedMethods></AllowedMethods><ForwardedValues><QueryString>false</QueryString><Cookies><Forward>none</Forward></Cookies></ForwardedValues><MinTTL>0</MinTTL><DefaultTTL>60</DefaultTTL><MaxTTL>86400</MaxTTL></DefaultCacheBehavior><Comment>local only</Comment><Enabled>true</Enabled></DistributionConfig>"
            }
          }
        }
