{
  "openapi": "3.0.3",
  "info": {
    "title": "Local CloudFront distributions",
    "version": "2020-05-31",
    "description": "Bounded native REST/XML APIs for one saved local S3 origin. Seed the example bucket and object first. Static example IDs do not identify existing resources. DomainName uses .invalid and is never fetched. Use the separately documented authenticated simulator-only content route; no external origin traffic, edge network or live CDN."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
