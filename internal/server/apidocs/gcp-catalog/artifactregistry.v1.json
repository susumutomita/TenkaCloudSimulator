 "info": {
  "description": "Bounded simulator subset of the official Artifact Registry API (v1) discovery document. Every other official method returns HTTP 501 UNIMPLEMENTED. Repositories are configuration metadata: no package, image, file, version or tag is stored, no registry endpoint (registryUri) is served and sizeBytes stays 0. Remote and virtual repositories never contact an upstream. Upstream credentials must be Secret Manager version names, which are stored as references and never resolved. Cleanup policies and vulnerability scanning settings are stored but never run. Mode, format, KMS key, remote and virtual configuration cannot be updated. Long-running operations complete synchronously.",
  "title": "Artifact Registry (simulator catalog)",
  "version": "v1"
 },
 "openapi": "3.1.0",
