 "info": {
  "description": "Bounded simulator subset of the official Cluster Director API (v1) discovery document. Every other official method returns HTTP 501 UNIMPLEMENTED. Clusters are configuration metadata: no VM, accelerator, network, storage or Slurm orchestrator is provisioned and no job runs. Only description and labels can be updated. Long-running operations complete synchronously and remain readable through operations.get/list.",
  "title": "Cluster Director (simulator catalog)",
  "version": "v1"
 },
