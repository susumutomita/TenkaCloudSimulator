 "tags": [
  {
   "description": "Bounded simulator subset of the official Backup for GKE API (v1) discovery document. Every other official method returns HTTP 501 UNIMPLEMENTED. Backup plans and restore plans are configuration metadata: the GKE cluster name is checked only for its format, no Backup for GKE agent runs, and no Kubernetes resource or volume is backed up or restored; plans report READY immediately. A restore plan must name an existing backup plan. Deactivated plans and locked retention policies are refused because their locks are not enforced. Backups, restores and channels remain unimplemented. Long-running operations complete synchronously.",
   "name": "Backup for GKE"
  }
 ],
