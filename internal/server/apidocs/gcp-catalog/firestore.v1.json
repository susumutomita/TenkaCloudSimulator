      "name": "projectsId",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "showDeleted",
      "required": false,
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GoogleFirestoreAdminV1ListDatabasesResponse"
        }
       }
      },
      "description": "Successful response."
     },
     "400": {
      "description": "INVALID_ARGUMENT or FAILED_PRECONDITION google.rpc.Status."
     },
     "403": {
      "description": "PERMISSION_DENIED for a project or subject other than the configured owner."
     },
     "404": {
      "description": "NOT_FOUND."
     },
     "409": {
      "description": "ALREADY_EXISTS or ABORTED."
     }
    },
    "summary": "projects.databases.list",
