 "info": {
  "description": "Bounded simulator subset of the official Cloud Firestore API (v1) discovery document. Every other official method returns HTTP 501 UNIMPLEMENTED. Databases, backup schedules and composite indexes are configuration metadata: no document store, query engine, index build or backup exists, and indexes report READY immediately without duplicate-definition checks; collection group IDs are limited to 100 letters, digits, underscores, hyphens and dots. The documents, export, import, clone, restore, field and user credential methods remain unimplemented. Deleting a database removes its backup schedules and indexes immediately and keeps no deleted database for showDeleted; deletion protection blocks delete. Tag bindings are refused. Operations complete synchronously under projects/{project}/databases/{database}/operations.",
  "title": "Firestore (simulator catalog)",
  "version": "v1"
 },
 "openapi": "3.1.0",
 "paths": {
  "/v1/projects/{projectsId}/databases": {
