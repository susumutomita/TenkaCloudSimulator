 "info": {
  "description": "Bounded simulator subset of the official Cloud Workstations API (v1) discovery document. Every other official method returns HTTP 501 UNIMPLEMENTED. Workstation clusters, configurations and workstations are configuration metadata: no control plane, gateway, VM, disk or container is created, and workstations stay STATE_STOPPED; start, stop and access tokens are not implemented. Control plane IP addresses, workstation hosts and usable-workstation listings are not reported. Deleting a cluster or configuration that has children requires force=true. Long-running operations complete synchronously and remain readable through operations.get/list.",
  "title": "Cloud Workstations (simulator catalog)",
  "version": "v1"
 },
 "openapi": "3.1.0",
