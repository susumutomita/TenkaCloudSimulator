[Unit]
Description=TenkaCloud guest-only interactive session relay
After=systemd-udev-settle.service
ConditionPathExists=/dev/virtio-ports/org.tenkacloud.session.0
ConditionPathExists=/etc/tenkacloud/session-relay-image

[Service]
Type=simple
ExecStart=/usr/libexec/tenkacloud-session-relay
User=root
Group=root
Restart=on-failure
RestartSec=1
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
